{
  "swarm-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-guard codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-hooks codex PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-hooks codex PostToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-format codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.local/bin/build-lint codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.local/bin/build-hooks codex Stop",
        "timeout": 30
      }
    ]
  }
}
