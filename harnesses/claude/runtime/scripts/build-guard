#!/usr/bin/env bash
# build-guard — block forbidden shell commands for the builder. PreToolUse, blocking.
# Harness-aware: reads the command and emits the deny verdict in each harness's own shape.
#   claude: stdin .tool_input.command      -> {hookSpecificOutput:{permissionDecision:"deny",...}}
#   agy:    stdin .toolCall.args.CommandLine -> {decision:"deny",reason:...}   (Antigravity contract)
#
# Merge authority: merging a pull request belongs to the main conversation, the only caller holding
# the review and the checks. Claude Code and Codex stamp `agent_id`/`agent_type` into the PreToolUse
# payload for a subagent's call and omit both for the main session, so the payload — not the
# environment, which is identical either way — decides; Antigravity names no caller and registers
# hooks session-wide, so merges there fail closed. `--admin`/`--auto` stay denied for everyone.
#
# Eval mode: a task repository bootstrapped by scripts/bootstrap-eval.sh carries
# .workcell/eval-mode.json. Inside one, the run is an unattended benchmark — no human to pause for
# and, normally, no remote to protect — so commit/merge/rebase/cherry-pick/push on main are allowed
# there, and every `gh` call is denied instead, the top-level session's merges included: GitHub is
# out of scope for an eval. The marker is read from the repository the command targets, so it can
# relax nothing outside that repository, and no other rule changes.
#
# This is a hard boundary, so it fails closed: exit 2 with a reason on stderr when jq is
# missing, the payload is not JSON, or the payload carries no command. Silent (allow) otherwise.
#
# The command is tokenized instead of regex-matched. Quoted arguments that contain whitespace
# (commit messages, echo/grep text) are dropped before any rule looks at the words, so
# `git commit -m "merge main"` cannot trip a rule, while `git push origin "main"` still can.
# Segments split on ; & | && || newlines and (sub)shell brackets are judged one at a time, with
# in-line state for `checkout main && git merge` and `jj bookmark set main && jj git push`.
#
# The command string alone is not enough, so the guard also reads the live repository the command
# targets — its own working directory, or the one the command named with -C/--git-dir/--work-tree:
#   * `git config --get alias.<sub>` expands a configured alias (as do inline `-c alias.x=y`
#     pairs) before any rule judges the subcommand, so `git p origin main` is seen as `git push`;
#   * `git symbolic-ref` supplies the checked-out branch, so commit/merge/rebase/cherry-pick is
#     denied on main even when the `git checkout main` arrived in an earlier tool call.
# A guarded command word behind `xargs` is denied outright: its operands arrive on stdin, which
# the guard cannot read, so there is nothing to judge and no safe way to guess.
#
# Residual gaps, by design: a detached HEAD (the normal state in a jj-colocated repo) and a
# non-repository both read as "not on main" and fail open, so those workflows are policed by the
# jj rules alone; and an alias whose body the tokenizer cannot recover (quoted text containing
# whitespace) is denied as obfuscation rather than expanded.
# POSIX ERE only — portable to BSD grep/awk.
set -uo pipefail
harness="${1:-claude}"

fail(){ printf 'build-guard: %s\n' "$1" >&2; exit 2; }
command -v jq  >/dev/null 2>&1 || fail "jq is required to parse the hook payload; failing closed"
command -v awk >/dev/null 2>&1 || fail "awk is required to tokenize the command; failing closed"

payload=$(cat)
case "$harness" in
  agy) filter='.toolCall.args.CommandLine // .toolCall.args.command // empty'
       deny(){ jq -n --arg r "$1" '{decision:"deny",reason:$r}'; exit 0; } ;;
  *)   filter='.tool_input.command // empty'
       deny(){ jq -n --arg r "$1" \
         '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'; exit 0; } ;;
esac
cmd=$(printf '%s' "$payload" | jq -r "$filter" 2>/dev/null) || fail "hook payload is not valid JSON; failing closed"
[[ -n $cmd ]] || fail "hook payload has no command for harness '$harness'; failing closed"

# Who called: the calling subagent's identity, empty for a harness's own top-level session.
# Read only by rule_gh. Antigravity carries no such field, so it stays empty there.
caller=""
if [[ $harness != agy ]]; then
  caller=$(printf '%s' "$payload" | jq -r '.agent_id // .agent_type // empty' 2>/dev/null) \
    || fail "hook payload is not valid JSON; failing closed"
fi

# Antigravity registers plugin hooks for the whole session rather than for one agent. Prefer an
# explicit builder identity if a future payload supplies one; with today's identity-free payload,
# enforce only inside a project that opted into Workcell through bootstrap-project.sh --install.
if [[ $harness == agy ]]; then
  agent_type=$(printf '%s' "$payload" | jq -r \
    '.agent_type // .agentType // .toolCall.agent_type // .toolCall.agentType // empty' 2>/dev/null) \
    || fail "hook payload is not valid JSON; failing closed"
  if [[ -n $agent_type ]]; then
    [[ $agent_type == workcell:builder || $agent_type == builder ]] || exit 0
  else
    scope=$PWD
    while [[ $scope != / && ! -e $scope/.agents/plugins/workcell ]]; do scope=${scope%/*}; [[ -n $scope ]] || scope=/; done
    [[ -e $scope/.agents/plugins/workcell ]] || exit 0
  fi
fi

# --- tokenizer -----------------------------------------------------------------------------------
# Emits one token per line. `;` lines are segment boundaries. Quoted text with no whitespace is
# glued into the surrounding word (so "main" and '/tmp/x' are seen); quoted text containing
# whitespace is dropped from the word and emitted as a `Q<TAB>text` line so `bash -c` / `eval`
# bodies can be re-checked.
tokenize(){
  awk '
    { line = line (NR > 1 ? "\n" : "") $0 }
    END {
      n = length(line); tok = ""; q = ""; qbuf = ""
      for (i = 1; i <= n; i++) {
        c = substr(line, i, 1)
        if (q != "") {
          if (c == q) {
            if (qbuf ~ /[ \t\n]/) { gsub(/\n/, ";", qbuf); print "Q\t" qbuf } else tok = tok qbuf
            q = ""; qbuf = ""; continue
          }
          if (c == "\\" && q == "\"" && i < n) { i++; c = substr(line, i, 1) }
          qbuf = qbuf c; continue
        }
        if (c == "\"" || c == "\047") { q = c; continue }
        if (c == "\\" && i < n) { i++; tok = tok substr(line, i, 1); continue }
        if (c == "$" && substr(line, i + 1, 1) == "(") { if (tok != "") print tok; tok = ""; print ";"; i++; continue }
        if (c == "$" && substr(line, i + 1, 1) == "{") {   # ${VAR...} is part of the word, not a brace group
          j = index(substr(line, i), "}"); if (j == 0) j = n - i + 1
          tok = tok substr(line, i, j); i += j - 1; continue
        }
        if (c ~ /[;&|\n(){}`]/) { if (tok != "") print tok; tok = ""; print ";"; continue }
        if (c ~ /[ \t]/) { if (tok != "") print tok; tok = ""; continue }
        tok = tok c
      }
      if (tok != "") print tok
      print ";"
    }'
}

# --- judgement state -------------------------------------------------------------------------------
# One payload's verdict state, shared by every (recursive) check/analyze_segment call so that a
# nested `bash -c` body or an alias expansion still sees `git checkout main && git mrg feat`.
# git_depth is a per-payload budget: every alias expansion spends one, so alias cycles terminate.
# git_ctx carries the repository an expanding alias targets down into its expansion.
on_main=0; jj_main=0; via_xargs=0; git_depth=0; git_ctx=()

# --- helpers ---------------------------------------------------------------------------------------
is_protected(){ [[ $1 == main || $1 == master ]]; }
is_tmpfs_dir(){ [[ $1 =~ ^(/tmp|/dev/shm|\$TMPDIR|\$\{TMPDIR[^}]*\})(/.*)?$ ]]; }
is_opt(){ [[ $1 == -* || $1 =~ ^[0-9]*[\<\>] ]]; }
# positionals <value-taking-opts-regex> <args...> -> sets `pos` to the non-option words
positionals(){
  local skip=$1; shift; pos=()
  while (($#)); do
    if [[ $1 == -- ]]; then shift; pos+=("$@"); return; fi
    if [[ -n $skip && $1 =~ ^($skip)$ ]]; then (($# >= 2)) || return; shift 2; continue; fi
    is_opt "$1" || pos+=("$1"); shift
  done
}
live_branch(){
  command -v git >/dev/null 2>&1 || return 0
  git --no-pager "$@" symbolic-ref --quiet --short HEAD 2>/dev/null
}
# eval_mode [git-prefix-args...] -> true when the repository the command targets is the task
# repository of an eval run. The repository is resolved the way live_branch resolves the branch —
# through the -C/--git-dir/--work-tree the command named — and the marker counts only where
# bootstrap-eval.sh puts it: at that toplevel, exactly. There is deliberately no upward walk, since
# a marker in a parent directory would otherwise relax every repository nested under it, and a path
# git cannot resolve to a toplevel is not in eval mode at all. When the eval driver exported
# WORKCELL_EVAL_TASK_DIR, only that one repository qualifies.
eval_mode(){
  local top
  command -v git >/dev/null 2>&1 || return 1
  top=$(git --no-pager "$@" rev-parse --show-toplevel 2>/dev/null) || return 1
  [[ -n $top && -f $top/.workcell/eval-mode.json ]] || return 1
  [[ -z ${WORKCELL_EVAL_TASK_DIR:-} ]] || [[ $top == "${WORKCELL_EVAL_TASK_DIR%/}" ]]
}
# eval_declared -> the eval driver named a task directory in the environment. Independent of the
# working directory, so cd-ing out of the task repository cannot buy the GitHub surface back.
eval_declared(){ [[ -n ${WORKCELL_EVAL_TASK_DIR:-} ]]; }
# is_eval_marker PATH -> PATH names the file that turns eval mode on.
is_eval_marker(){ local re='(^|/)\.workcell/eval-mode\.json$'; [[ $1 =~ $re ]]; }
marker_reason="eval mode is entered by a human running bootstrap-eval.sh, never by an agent — .workcell/eval-mode.json is not an agent's file to write"
xargs_operands(){
  xrest=()
  while (($#)); do
    case $1 in
      --) shift; xrest=("$@"); return 0 ;;
      -n|-I|-d|-L|-P|-s|-E|-a|--max-args|--replace|--delimiter|--max-lines|--max-procs|--max-chars|--arg-file|--process-slot-var)
        (($# >= 2)) || return 0; shift 2 ;;
      -*) shift ;;
      *)  xrest=("$@"); return 0 ;;
    esac
  done
}
env_assign(){
  local name=${1%%=*} val=${1#*=}
  case $name in
    CARGO_TARGET_DIR|CARGO_BUILD_TARGET_DIR)
      is_tmpfs_dir "$val" && deny "don't point $name at $val (RAM-backed tmpfs) — use ~/.cache/cargo-target" ;;
  esac
}

# --- per-command rules -----------------------------------------------------------------------------
git_alias(){
  local name=$1 kv val="" found=0
  for kv in "${galias[@]}"; do
    [[ ${kv%%=*} == "$name" ]] || continue
    found=1; val=""; [[ $kv == *=* ]] && val=${kv#*=}
  done
  ((found)) && [[ -z $val ]] && deny \
    "builder must not define a git alias inline and invoke it in the same command — 'git -c alias.$name=…' hides the real subcommand from the guard"
  ((found)) || { command -v git >/dev/null 2>&1 \
    && val=$(git --no-pager "${gpre[@]}" config --get "alias.$name" 2>/dev/null); }
  [[ -n $val ]] || return 0
  ((git_depth++ < 16)) || return 0
  local -a ctx=("${git_ctx[@]}"); git_ctx=("${gpre[@]}")
  if [[ $val == !* ]]; then check "${val#!} ${rest[*]}"
  else
    local -a words=(); read -ra words <<<"$val"
    ((${#words[@]})) && rule_git "${gopts[@]}" "${words[@]}" "${rest[@]}"
  fi
  git_ctx=("${ctx[@]}")
}
rule_git(){
  local sub="" ; local -a rest=() pos=() galias=() gopts=() gpre=("${git_ctx[@]}")
  while (($#)); do
    case $1 in
      -c) if [[ ${2:-} == alias.?* ]]; then galias+=("${2#alias.}"); gopts+=(-c "$2"); fi
          (($# >= 2)) || return 0; shift 2; continue ;;
      -C|--git-dir|--work-tree) (($# >= 2)) || return 0; gpre+=("$1" "$2"); shift 2; continue ;;
      --git-dir=*|--work-tree=*) gpre+=("$1"); shift; continue ;;
      --namespace|--exec-path|--super-prefix) (($# >= 2)) || return 0; shift 2; continue ;;
      -*) shift; continue ;;
      *) sub=$1; shift; rest=("$@"); break ;;
    esac
  done
  case $sub in
    push)
      eval_mode "${gpre[@]}" && return 0   # an eval's work lands on the task repo's default branch
      positionals '-o|--push-option|--receive-pack|--exec|--repo' "${rest[@]}"
      ((${#pos[@]} >= 2)) || deny "git push must name the remote and your issue branch explicitly — a bare push targets the current branch, which may be main"
      local ref dest
      for ref in "${pos[@]:1}"; do
        dest=${ref#*:}; dest=${dest#+}; dest=${dest#refs/heads/}
        if is_protected "$dest" || [[ $dest == HEAD ]]; then
          deny "builder must not push to $dest — push your issue branch instead"; fi
      done ;;
    branch)
      local force=0 a
      for a in "${rest[@]}"; do case $a in
        -f|--force|-M|-m|-D|-d|-C|-c|--move|--copy|--delete) force=1 ;;
      esac; done
      positionals '-u|--set-upstream-to|-t|--track' "${rest[@]}"
      if ((force)); then for a in "${pos[@]}"; do
        is_protected "$a" && deny "builder must not rewrite, rename or delete branch $a"; done; fi ;;
    update-ref)
      local a; for a in "${rest[@]}"; do
        [[ $a =~ ^refs/heads/(main|master)$ ]] && deny "builder must not rewrite $a directly"; done ;;
    checkout|switch)
      positionals '-b|-B|-c|-C|--orphan|--track|-t' "${rest[@]}"
      local a; for a in "${pos[@]}"; do is_protected "$a" && on_main=1; done
      # `git checkout -b main` / `git switch -c main` creates and lands on a branch named main
      local i; for ((i = 0; i + 1 < ${#rest[@]}; i++)); do
        [[ ${rest[i]} =~ ^(-b|-B|-c|-C)$ ]] && is_protected "${rest[i+1]}" && on_main=1; done ;;
    merge|commit|cherry-pick|rebase)
      eval_mode "${gpre[@]}" && return 0
      ((on_main)) && deny "builder must not $sub on main — this line checks out main first"
      local head; head=$(live_branch "${gpre[@]}")
      is_protected "$head" && deny "builder must not $sub while HEAD is on $head — switch to your issue branch first" ;;
    ?*) git_alias "$sub" ;;
  esac
}
# Merging is the main conversation's call, so a named caller is a subagent and is denied. Only
# Claude Code and Codex name one; on Antigravity every merge is denied because nothing there
# distinguishes the session's own commands from an agent's. In eval mode the question does not
# arise: nothing GitHub-shaped runs at all, whoever asked.
rule_gh(){
  { eval_declared || eval_mode; } && deny "eval mode: GitHub is out of scope — no gh, no issues, no pull requests; land the work as local commits on the task repository"
  local -a pos=(); positionals '-R|--repo|-X|--method|-f|-F|--field|--raw-field|-H|--header' "$@"
  local a why=""
  [[ ${pos[0]:-} == pr && ${pos[1]:-} == merge ]] && why="builder must not merge pull requests — hand the PR back for review"
  for a in "$@"; do
    [[ $a =~ /pulls/[0-9]+/merge$ ]] && why="builder must not merge pull requests via the API"; done
  [[ -n $why ]] || return 0
  [[ $harness != agy && -z $caller ]] || deny "$why"
  # What the main conversation gets is an ordinary merge of a pull request a human has seen green.
  for a in "$@"; do
    [[ $a == --admin || $a == --auto ]] && deny \
      "gh pr merge $a bypasses the checks the pull request exists for — merge it plainly once review and CI are green"; done
}
rule_jj(){
  local sub="" ; local -a rest=() pos=()
  while (($#)); do
    case $1 in
      -R|--repository|--at-op|--at-operation|--config|--config-toml|--config-file)
          (($# >= 2)) || return 0; shift 2; continue ;;
      -*) shift; continue ;;
      *) sub=$1; shift; rest=("$@"); break ;;
    esac
  done
  case $sub in
    bookmark|b)
      positionals '-r|--revision|--to|--from' "${rest[@]}"
      case ${pos[0]:-} in set|move|create|c|s|m|track)
        local a; for a in "${pos[@]:1}"; do is_protected "$a" && jj_main=1; done ;;
      esac ;;
    git)
      [[ ${rest[0]:-} == push ]] || return 0
      eval_mode && return 0
      ((jj_main)) && deny "builder must not push main — this line moves the main bookmark first"
      local named=0 i a
      for ((i = 1; i < ${#rest[@]}; i++)); do
        a=${rest[i]}
        case $a in
          --all|--tracked|--deleted) deny "jj git push $a may push main — name your issue bookmark with --bookmark" ;;
          -b|--bookmark|--named|-c|--change|-r|--revisions)
            named=1; ((i + 1 < ${#rest[@]})) && is_protected "${rest[i+1]%%=*}" \
              && deny "builder must not push bookmark ${rest[i+1]%%=*} — push your issue bookmark instead" ;;
          --bookmark=*|--named=*|--change=*|--revisions=*)
            named=1; a=${a#*=}; is_protected "${a%%=*}" \
              && deny "builder must not push bookmark ${a%%=*} — push your issue bookmark instead" ;;
        esac
      done
      ((named)) || deny "jj git push must name your issue bookmark (--bookmark/--named) — a bare push may include main" ;;
  esac
}
# Entering eval mode is a human's act — scripts/bootstrap-eval.sh, run by whoever set the run up.
# An agent that could write the marker itself could switch off its own branch protections, so the
# write vectors the tokenizer can see are denied whatever mode the repository is in: a redirection
# target (`> f`, `>>f`, `1>f`, and the same glued to the preceding word) and the file operands of
# the commands that copy one path onto another. A path assembled inside a quoted script body is
# beyond the tokenizer, and that residual is recorded in ADR 0013.
rule_marker(){
  local base=$1 a t next=0; shift
  case $base in
    tee|cp|mv|install|ln|dd|truncate)
      # dd names its operands `of=<path>`/`if=<path>`, so the path is not the whole word.
      for a in "$@"; do
        t=$a; [[ $t =~ ^[A-Za-z_]+= ]] && t=${t#*=}
        is_eval_marker "$t" && deny "$marker_reason"
      done ;;
  esac
  for a in "$@"; do
    if ((next)); then next=0; is_eval_marker "$a" && deny "$marker_reason"; continue; fi
    case $a in
      *'>'*) t=${a##*>}; if [[ -n $t ]]; then is_eval_marker "$t" && deny "$marker_reason"; else next=1; fi ;;
    esac
  done
}
rule_cargo(){
  while (($#)); do
    case $1 in
      --target-dir=*) is_tmpfs_dir "${1#*=}" && deny "don't write cargo artifacts under ${1#*=} (RAM-backed tmpfs) — use ~/.cache/cargo-target" ;;
      --target-dir)   is_tmpfs_dir "${2:-}"  && deny "don't write cargo artifacts under $2 (RAM-backed tmpfs) — use ~/.cache/cargo-target"; shift ;;
    esac
    shift
  done
}

# --- driver ------------------------------------------------------------------------------------------
# analyze_segment: strip leading env assignments / wrappers, dispatch on the command word.
analyze_segment(){
  local -a seg=("$@") ; local i=0 n=${#seg[@]}
  while ((i < n)); do
    case ${seg[i]} in
      [A-Za-z_]*=*) env_assign "${seg[i]}"; ((i++)) ;;
      env|sudo|command|exec|nohup|time|nice|export|declare|builtin|doas) ((i++)) ;;
      -*) ((i++)) ;;   # options to the wrapper (sudo -u, env -i, ...)
      *) break ;;
    esac
  done
  ((i < n)) || return 0
  local base=${seg[i]##*/}
  ((via_xargs)) && [[ $base =~ ^(git|gh|jj)$ ]] && deny \
    "builder must not reach $base through xargs — its operands arrive on stdin, where the guard cannot inspect them; run $base directly"
  rule_marker "$base" "${seg[@]}"   # every segment: a redirection can write the marker from any command
  case $base in
    git)   rule_git   "${seg[@]:i+1}" ;;
    gh)    rule_gh    "${seg[@]:i+1}" ;;
    jj)    rule_jj    "${seg[@]:i+1}" ;;
    cargo) rule_cargo "${seg[@]:i+1}" ;;
    xargs) local -a xrest=(); xargs_operands "${seg[@]:i+1}"
           ((${#xrest[@]})) && { via_xargs=1; analyze_segment "${xrest[@]}"; } ;;
    bash|sh|zsh|dash|ksh|eval) local q; for q in "${quoted[@]}"; do check "$q"; done ;;
  esac
}
# check <command-string>: tokenize, then judge each segment. Recursive for shell -c / eval bodies.
check(){
  local t; local -a seg=() quoted=()
  while IFS= read -r t; do
    case $t in
      ';')      analyze_segment "${seg[@]}"; seg=(); quoted=(); via_xargs=0 ;;
      $'Q\t'*)  quoted+=("${t#Q$'\t'}") ;;
      *)        seg+=("$t") ;;
    esac
  done < <(printf '%s' "$1" | tokenize)
}
check "$cmd"
exit 0
