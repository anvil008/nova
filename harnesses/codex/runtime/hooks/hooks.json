{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-guard codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-hooks codex PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-hooks codex PostToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/build-format codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.local/bin/build-lint codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.local/bin/build-hooks codex Stop",
        "timeout": 30
      }
    ]
  }
}
