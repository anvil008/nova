#!/usr/bin/env bash
# build-hooks — the builder agent's TDD build gate. Thin wrapper over tdd-guard.
# Fails closed: a missing tdd-guard (or missing arguments) is exit 2 with a reason, so the
# harness blocks the tool call instead of silently skipping the gate.
#
# It also owns one rule of its own, because it is the hook wired to Edit/Write: the eval-mode
# marker is not an agent's file to write. build-guard denies the shell vectors; this denies the
# editor ones, reading each harness's payload dialect and answering in its deny shape.
set -uo pipefail
harness=${1:-}; event=${2:-}
[[ -n $harness && -n $event ]] || { printf 'build-hooks: usage: build-hooks <claude|codex|agy> <event>\n' >&2; exit 2; }
guard="$HOME/.local/bin/tdd-guard"
[[ -x $guard ]] || { printf 'build-hooks: %s is missing or not executable — run scripts/bootstrap-tools.sh --install; failing closed\n' "$guard" >&2; exit 2; }

payload=$(cat)
if [[ $event == PreToolUse ]] && command -v jq >/dev/null 2>&1; then
  path=$(printf '%s' "$payload" | jq -r \
    '.tool_input.file_path // .tool_input.notebook_path // .toolCall.args.TargetFile
     // .toolCall.args.AbsolutePath // .args.TargetFile // empty' 2>/dev/null)
  if [[ $path == *.workcell/eval-mode.json ]]; then
    reason="eval mode is entered by a human running bootstrap-eval.sh, never by an agent — .workcell/eval-mode.json is not an agent's file to write"
    case $harness in
      agy) jq -n --arg r "$reason" '{decision:"deny",reason:$r}' ;;
      *)   jq -n --arg r "$reason" \
             '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}' ;;
    esac
    exit 0
  fi
fi
exec "$guard" hook --harness "$harness" --event "$event" <<<"$payload"
