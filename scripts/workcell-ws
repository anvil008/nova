#!/usr/bin/env bash
# workcell-ws — the one isolated-workspace helper, identical on every harness.
#
#   workcell-ws add <key> [--base <rev>] [--repo <dir>]     create ../<repo>-<key>, bookmark <key>
#   workcell-ws forget <key> [--force] [--repo <dir>]       drop the working copy, keep the bookmark
#   workcell-ws list [--repo <dir>]                         every workspace, with its state
#   workcell-ws sweep [--apply] [--force] [--repo <dir>]    report — or remove — what leaked
#
# Design notes:
#  * One naming convention: a key is <type>/<slug> — feature, bug, doc, refactor, perf, test,
#    release, chore, review, integration — or a bare slug, and it is the bookmark/branch verbatim.
#    Directories and jj workspace names cannot carry the slash, so both write it as a dash: key
#    feature/xyz is bookmark feature/xyz, jj workspace feature-xyz, directory ../<repo>-feature-xyz.
#    A jj repo (a .jj/ at or above the working directory) gets a jj workspace, a git-only repo a git
#    worktree; the subcommands, the naming, and the table are identical either way, so an agent on
#    any harness needs one command and one rule — work only inside the directory it printed.
#  * Nothing here rewrites history. `forget` drops a working copy and never the bookmark or its
#    commits, `sweep` deletes only a ref already contained in the default branch, and no
#    subcommand touches a remote.
#  * Nothing here destroys uncommitted work. A jj working copy is a commit, so it is snapshotted
#    into the repository before the directory goes; a git working tree is not, so a dirty one is
#    refused by name until it is committed or --force is passed.
#  * A sibling is only ours when it carries a *pointer* back to this repository. An independent
#    repository that merely collides on the naming convention is `foreign`, and no --apply touches
#    it.
#  * Every subcommand works from the repo, from one of its workspaces, or with --repo.
set -uo pipefail

die(){ printf 'workcell-ws: %s\n' "$*" >&2; exit 1; }

CALLER=$(pwd -P)   # captured before --repo moves us: the shell we must not saw the branch off
CMD=${1:-}; [[ $# -gt 0 ]] && shift
KEY=""; BASE=""; REPO=""; APPLY=0; FORCE=0
case $CMD in
  add|forget)
    KEY=${1:-}
    [[ -n $KEY && $KEY != -* ]] || die "usage: workcell-ws $CMD <key> [--repo <dir>]"
    shift;;
  list|sweep) ;;
  -h|--help|"") sed -n '2,7p' "$0"; exit 0;;
  *) die "unknown subcommand: $CMD (add|forget|list|sweep)";;
esac
while (($#)); do case $1 in
  --base)  [[ $CMD == add ]] || die "--base applies to add only"
           BASE=${2:?"--base needs a revision"}; shift 2;;
  --repo)  REPO=${2:?"--repo needs a directory"}; shift 2;;
  --apply) [[ $CMD == sweep ]] || die "--apply applies to sweep only"
           APPLY=1; shift;;
  --force) [[ $CMD == forget || $CMD == sweep ]] || die "--force applies to forget and sweep only"
           FORCE=1; shift;;
  *) die "unexpected argument: $1";;
esac; done
[[ -z $KEY || $KEY =~ ^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$ ]] \
  || die "refusing key '$KEY': a key is <type>/<slug> or a bare slug, each part lower-case letters, digits, and dashes, starting with a letter or digit"
# The directory and the jj workspace name cannot carry the slash a bookmark carries, so they take
# the dashed form of the key. Without a slash the two are the same string, as they always were.
DIRKEY=${KEY//\//-}

# --- which repository, and which version control ------------------------------------------------
cd "${REPO:-$PWD}" 2>/dev/null || die "no such directory: ${REPO:-$PWD}"

# find_up NAME -> the nearest directory at or above the working directory containing NAME.
find_up(){
  local d; d=$(pwd -P)
  while :; do
    [[ -e $d/$1 ]] && { printf '%s\n' "$d"; return 0; }
    [[ $d == / ]] && return 1
    d=${d%/*}; d=${d:-/}
  done
}

WS=$(find_up .jj) || WS=""
if [[ -n $WS ]]; then
  VCS=jj
  command -v jj >/dev/null 2>&1 || die "$WS is a jj repository but jj is not installed"
  # In a secondary workspace .jj/repo is a file holding the path of the primary's .jj/repo.
  if [[ -d $WS/.jj/repo ]]; then TOP=$WS
  else TOP=$(cd "$WS/.jj/$(dirname "$(cat "$WS/.jj/repo")")/.." 2>/dev/null && pwd -P) \
         || die "cannot resolve the primary workspace of $WS"
  fi
  STORE="$TOP/.jj/repo"
else
  VCS=git
  TOP=$(git worktree list --porcelain 2>/dev/null | sed -n '1s|^worktree ||p')
  [[ -n $TOP ]] || die "not a jj or git repository: $(pwd -P)"
  TOP=$(cd "$TOP" && pwd -P)
  # Where git keeps this repository's per-worktree state; every worktree of ours points inside it.
  STORE=$(git -C "$TOP" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
fi
PARENT=$(dirname "$TOP")
PREFIX="$PARENT/$(basename "$TOP")-"
if [[ $VCS == jj ]]; then UNIT="jj workspace"; REF=bookmark; else UNIT="git worktree"; REF=branch; fi

# The revision every "is this merged?" question is asked against, and the name of the branch that
# carries it — a local ref by that name is the default branch itself and is never swept, however
# far behind its remote it has fallen. It is also the base `add` defaults to: jj's trunk() degrades
# to the root commit when no remote lets it resolve, and branching a workspace there hands an agent
# an empty tree, so trunk() is used only once it is known to resolve to a real commit.
jjq(){ jj -R "$TOP" --ignore-working-copy "$@" 2>/dev/null; }
DEFAULT=""; DEFAULT_NAME=""
if [[ $VCS == jj ]]; then
  if [[ -n $(jjq log --no-graph -r 'trunk() ~ root()' -T '"x"') ]]; then
    DEFAULT='trunk()'
    for b in main master trunk; do
      [[ -n $(jjq log --no-graph -r "remote_bookmarks(exact:\"$b\")" -T '"x"') ]] \
        && { DEFAULT_NAME=$b; break; }
    done
  fi
  if [[ -z $DEFAULT ]]; then
    for b in main master trunk; do
      [[ -n $(jjq log --no-graph -r "bookmarks(exact:\"$b\")" -T '"x"') ]] \
        && { DEFAULT_NAME=$b; DEFAULT="bookmarks(exact:\"$b\")"; break; }
    done
  fi
else
  DEFAULT=$(git -C "$TOP" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -z $DEFAULT ]]; then
    for b in main master trunk; do
      git -C "$TOP" show-ref --verify --quiet "refs/heads/$b" && { DEFAULT=$b; break; }
    done
  fi
  [[ -n $DEFAULT ]] || DEFAULT=$(git -C "$TOP" symbolic-ref --short HEAD 2>/dev/null)
  DEFAULT_NAME=${DEFAULT#origin/}
fi

# --- reading the repository ---------------------------------------------------------------------
# merged REF -> the bookmark/branch is a *strict* ancestor of the default branch. Strict, because
# a ref sitting exactly on the default tip is either a workspace an agent created seconds ago
# (git branches a worktree at the tip) or one that fast-forwarded; sweeping the first is far worse
# than leaving the second until the tip moves on.
merged(){
  [[ -n $1 && -n $DEFAULT ]] || return 1
  case $VCS in
    jj)  [[ -n $(jjq log --no-graph -r "(bookmarks(exact:\"$1\") & ::$DEFAULT) ~ $DEFAULT" -T '"x"') ]];;
    git) git -C "$TOP" merge-base --is-ancestor "$1" "$DEFAULT" 2>/dev/null \
           && [[ $(git -C "$TOP" rev-parse "$1" 2>/dev/null) \
                 != "$(git -C "$TOP" rev-parse "$DEFAULT" 2>/dev/null)" ]];;
  esac
}

# owned PATH -> PATH is a working copy of *this* repository. A workspace or worktree never carries
# its own object store, only a pointer back to the one at $STORE: git writes a `.git` file holding
# `gitdir: <common-dir>/worktrees/<name>`, jj a `.jj/repo` file holding a path to <top>/.jj/repo.
# A real `.git/` or `.jj/repo/` directory is an independent repository that merely collides on the
# naming convention, and nothing here may delete it. The git pointer is compared as a string,
# because a pruned worktree's target is already gone, while jj's target is the live store.
owned(){
  local p=$1 target
  if [[ $VCS == jj ]]; then
    [[ -f $p/.jj/repo ]] || return 1
    target=$(cd "$p/.jj" 2>/dev/null && cd "$(cat repo 2>/dev/null)" 2>/dev/null && pwd -P) || return 1
    [[ $target == "$STORE" ]]
  else
    [[ -f $p/.git ]] || return 1
    target=$(sed -n 's|^gitdir: ||p' "$p/.git" 2>/dev/null)
    [[ -n $target ]] || return 1
    [[ $target == "$STORE"/worktrees/* ]]
  fi
}

# local_refs -> every local bookmark / branch, one per line.
local_refs(){
  if [[ $VCS == jj ]]; then jjq bookmark list --all-remotes -T 'if(remote, "", name ++ "\n")'
  else git -C "$TOP" for-each-ref --format='%(refname:short)' refs/heads
  fi
}

# key_for DIRKEY -> the key a directory (or jj workspace) of that name was created from. Dashing the
# slash out is lossy on its own, so the answer comes from the refs: the key is the one local
# bookmark/branch whose dashed form is DIRKEY. An exact ref wins over a dashed one, which keeps a
# legacy dash-only key answering itself even where a slashed namesake also exists, and a directory
# no ref explains is its own key. Reads $REFS, which inventory fills once per run.
key_for(){
  local r
  [[ $REFS == *$'\n'"$1"$'\n'* ]] && { printf '%s\n' "$1"; return 0; }
  while IFS= read -r r; do
    [[ -n $r && ${r//\//-} == "$1" ]] && { printf '%s\n' "$r"; return 0; }
  done <<<"$REFS"
  printf '%s\n' "$1"
}

# git_worktrees -> path<TAB>branch (branch empty when detached), the primary worktree first.
git_worktrees(){
  git -C "$TOP" worktree list --porcelain | awk '
    /^worktree /{ if (p != "") print p "\t" b; p = substr($0, 10); b = "" }
    /^branch /{ b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    END{ if (p != "") print p "\t" b }'
}

# state_of REF PATH -> active | merged | stale-reg
state_of(){
  [[ -d $2 ]] || { printf 'stale-reg\n'; return 0; }
  if [[ $1 != "$DEFAULT_NAME" ]] && merged "$1"; then printf 'merged\n'; else printf 'active\n'; fi
}

# inventory -> key<TAB>path<TAB>revision<TAB>state, one row per workspace. The key is what `add` was
# given and what `forget` takes back, so it is reported in its slashed form however the directory
# and the jj workspace beneath it spell it.
#   active     registered and its directory is there
#   merged     live, but its bookmark/branch is already contained in the default branch
#   stale-reg  registered, directory gone (an agent removed the directory without forgetting)
#   stale-dir  ours by its pointer, but nothing registered it (an agent died mid-creation)
#   foreign    matches the naming convention but is an independent repository, never a sweep target
inventory(){
  local name path rev ref dir registered=$'\n'
  REFS=$'\n'$(local_refs)$'\n'
  if [[ $VCS == jj ]]; then
    while IFS=$'\t' read -r name path rev; do
      [[ -n $name ]] || continue
      # root() stops resolving once the directory is gone; the convention names it anyway.
      [[ $path == - ]] && path="$PREFIX$name"
      registered+="$path"$'\n'
      if [[ $name == default ]]; then ref=""
      else name=$(key_for "$name"); ref=$name
      fi
      printf '%s\t%s\t%s\t%s\n' "$name" "$path" "$rev" "$(state_of "$ref" "$path")"
    done < <(jjq workspace list \
      -T 'name ++ "\t" ++ if(self.root(), self.root(), "-") ++ "\t" ++ target.change_id().short() ++ "\n"')
  else
    while IFS=$'\t' read -r path rev; do
      [[ -n $path ]] || continue
      registered+="$path"$'\n'
      ref=$rev
      if [[ $path == "$TOP" ]]; then name=default; ref=""
      else
        name=${path#"$PREFIX"}; name=${name##*/}
        # git hands us the branch outright, so the directory needs no lookup: a branch that dashes
        # to this directory's name is the key it was created from.
        [[ -n $ref && ${ref//\//-} == "$name" ]] && name=$ref
      fi
      printf '%s\t%s\t%s\t%s\n' "$name" "$path" "${rev:-detached}" "$(state_of "$ref" "$path")"
    done < <(git_worktrees)
  fi
  for dir in "$PREFIX"*; do
    [[ -d $dir ]] || continue
    [[ $registered != *$'\n'"$dir"$'\n'* ]] || continue
    [[ -e $dir/.jj || -e $dir/.git ]] || continue
    name=$(key_for "${dir#"$PREFIX"}")
    if owned "$dir"; then printf '%s\t%s\t-\tstale-dir\n' "$name" "$dir"
    else printf '%s\t%s\t-\tforeign\n' "$name" "$dir"
    fi
  done
}

# --- changing the repository --------------------------------------------------------------------
# inside PATH -> the shell that invoked us sits at or under PATH, so removing it strands that shell.
inside(){
  local p
  p=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  [[ $CALLER == "$p" || $CALLER == "$p"/* ]]
}

# removable NAME PATH STATE -> silent success when the working copy can go without losing work,
# otherwise the reason on stdout and a non-zero return. --force skips every check but the dead-cwd
# one, which no flag can make safe.
#
# The three cases differ in what can vouch for the directory's contents:
#   stale-reg  the directory is already gone, so there is nothing to lose;
#   stale-dir  nothing has it registered, so neither jj nor git can say what is uncommitted in it
#              (`jj st` there answers "No working copy" and exits 0, which is not a snapshot) —
#              refused, because deleting it is irreversible;
#   active/merged  jj snapshots the working copy into its commit, which survives the forget, so
#              nothing is left to lose; git cannot, so a dirty tree is refused by name.
removable(){
  local path=$2 state=$3 dirty
  if inside "$path"; then
    printf 'the shell that called us is inside it — cd out of the workspace first'; return 1
  fi
  ((FORCE)) && return 0
  [[ -d $path ]] || return 0
  if [[ $state == stale-dir ]]; then
    printf 'nothing has it registered, so neither jj nor git can vouch for what is in it (--force overrides)'
    return 1
  fi
  if [[ $VCS == jj ]]; then
    jj -R "$path" st >/dev/null 2>&1 && return 0
    printf 'jj cannot snapshot it, so uncommitted work in it would be lost (--force overrides)'
    return 1
  fi
  dirty=$(git -C "$path" status --porcelain 2>/dev/null) || {
    printf 'git cannot say what is uncommitted in it (--force overrides)'; return 1; }
  [[ -n $dirty ]] || return 0
  printf 'uncommitted work in %s (commit it, or pass --force)' \
    "$(printf '%s' "$dirty" | sed 's|^...||' | tr '\n' ' ' | sed 's| *$||')"
  return 1
}

# forget_one NAME PATH -> drop the working copy, keeping its bookmark/branch and every commit.
# Callers clear it with `removable` first; this does the removal and nothing else.
forget_one(){
  local name=$1 path=$2 rc=0
  if [[ $VCS == jj ]]; then
    name=${name//\//-}   # the workspace jj registered, whose name never carries the bookmark's slash
    # Consume every row: grep -q can close the pipe early, making jj fail and
    # pipefail skip deregistration even though the requested name was found.
    if jjq workspace list -T 'name ++ "\n"' | grep -xF "$name" >/dev/null; then
      # Snapshot before forgetting: the working copy is a commit, and this is what preserves it.
      [[ -d $path ]] && jj -R "$path" st >/dev/null 2>&1
      jjq workspace forget "$name" || rc=1
    fi
  else
    if git -C "$TOP" worktree list --porcelain | grep -qxF "worktree $path"; then
      if [[ -d $path ]]; then
        if ((FORCE)); then git -C "$TOP" worktree remove --force "$path" >/dev/null 2>&1 || rc=1
        else git -C "$TOP" worktree remove "$path" >/dev/null 2>&1 || rc=1
        fi
      fi
      git -C "$TOP" worktree prune || rc=1
    fi
  fi
  # Only once the version control agreed to let go: `git worktree remove` deletes the directory
  # itself, so this clears the unregistered leftovers rather than pre-empting git's own refusal.
  if [[ $rc -eq 0 && -d $path ]]; then rm -rf -- "$path" || rc=1; fi
  return $rc
}

# delete_ref NAME -> drop a local bookmark / branch. Only ever called on a merged ref.
delete_ref(){
  if [[ $VCS == jj ]]; then jjq bookmark delete "$1" >/dev/null
  else git -C "$TOP" branch -d "$1" >/dev/null 2>&1
  fi
}

case $CMD in
add)
  TARGET="$PREFIX$DIRKEY"
  [[ -e $TARGET || -L $TARGET ]] && die "refusing to create $TARGET: it already exists"
  BASE=${BASE:-$DEFAULT}
  [[ -n $BASE ]] || die "cannot determine a base for $TOP: nothing for trunk() to resolve through and no local main/master/trunk — pass --base <rev>"
  if [[ $VCS == jj ]]; then
    jj -R "$TOP" workspace add --name "$DIRKEY" "$TARGET" -r "$BASE" \
      || die "jj workspace add failed for $KEY at $BASE"
    if local_refs | grep -qxF "$KEY"; then
      printf '  bookmark %s already exists — left where it points\n' "$KEY"
    else
      (cd "$TARGET" && jj bookmark create "$KEY" -r @) || die "jj bookmark create failed for $KEY"
    fi
  else
    git -C "$TOP" worktree add "$TARGET" -b "$KEY" "$BASE" \
      || die "git worktree add failed for $KEY at $BASE"
  fi
  printf 'created %s (%s %s, %s %s, base %s)\n' "$TARGET" "$UNIT" "$DIRKEY" "$REF" "$KEY" "$BASE"
  printf '  work only inside %s: never edit %s, and never push the default branch.\n' "$TARGET" "$TOP"
  ;;

forget)
  [[ $KEY == default ]] && die "refusing to forget the primary working copy"
  found=""; found_state=""; found_key=""
  while IFS=$'\t' read -r name path rev state; do
    # The dashed form is the identity a directory can hold, so it is what a key is matched on: a
    # workspace answers to the key it was made with, and to that key's directory spelling.
    [[ ${name//\//-} == "$DIRKEY" ]] || continue
    [[ $path == "$TOP" ]] && die "refusing to forget the primary working copy at $TOP"
    found=$path; found_state=$state; found_key=$name
  done < <(inventory)
  [[ -n $found ]] || die "no workspace '$KEY' in $TOP"
  [[ $found_state == foreign ]] \
    && die "refusing to forget $found: it is an independent repository, not a workspace of $TOP"
  why=$(removable "$found_key" "$found" "$found_state") || die "refusing to forget $found: $why"
  forget_one "$found_key" "$found" || die "could not forget $found_key at $found"
  printf 'forgot %s (%s) — %s %s and its commits are untouched\n' "$found" "$UNIT" "$REF" "$found_key"
  ;;

list)
  printf '%s (%s), workspaces alongside it as %s<key>, with / written as -\n' "$TOP" "$VCS" "$PREFIX"
  printf '%-16s %-14s %-10s %s\n' NAME REVISION STATE PATH
  while IFS=$'\t' read -r name path rev state; do
    printf '%-16s %-14s %-10s %s\n' "$name" "$rev" "$state" "$path"
  done < <(inventory)
  ;;

sweep)
  if ((APPLY)); then printf 'sweep %s (%s) — removing\n' "$TOP" "$VCS"
  else printf 'sweep %s (%s) — read-only; re-run with --apply to remove\n' "$TOP" "$VCS"
  fi
  found=0; failed=0; kept=$'\n'
  while IFS=$'\t' read -r name path rev state; do
    if [[ $state == foreign ]]; then
      printf '  note      %-10s %-16s %s — another repository, never swept\n' "$state" "$name" "$path"
      continue
    fi
    case $state in stale-dir|stale-reg|merged) ;; *) continue;; esac
    [[ $path == "$TOP" ]] && continue   # the primary working copy is never a leak
    found=$((found + 1))
    if ! why=$(removable "$name" "$path" "$state"); then
      printf '  kept      %-10s %-16s %s — %s\n' "$state" "$name" "$path" "$why"
      kept+="$name"$'\n'; continue
    fi
    if ((APPLY)); then
      if forget_one "$name" "$path"; then printf '  removed   %-10s %-16s %s\n' "$state" "$name" "$path"
      else printf '  FAILED    %-10s %-16s %s\n' "$state" "$name" "$path"; failed=1
      fi
    else
      printf '  %-10s %-16s %s\n' "$state" "$name" "$path"
    fi
  done < <(inventory)
  while IFS= read -r ref; do
    [[ -n $ref && $ref != "$DEFAULT_NAME" ]] || continue
    merged "$ref" || continue
    found=$((found + 1))
    # A ref whose workspace we just kept is not ours to delete: git refuses while the worktree still
    # holds the branch, and jj would silently drop the bookmark of a working copy we chose to keep.
    # Reporting it is the whole answer — keeping the sweep at exit 0 is what lets a resume step run
    # it unattended, so this is a note, never a failure.
    if [[ $kept == *$'\n'"$ref"$'\n'* ]]; then
      printf '  kept      %-10s %-16s workspace kept, remove it first\n' ref "$ref"; continue
    fi
    if ((APPLY)); then
      if delete_ref "$ref"; then printf '  deleted   %-10s %-16s merged into %s\n' ref "$ref" "$DEFAULT_NAME"
      else printf '  FAILED    %-10s %-16s merged into %s\n' ref "$ref" "$DEFAULT_NAME"; failed=1
      fi
    else
      printf '  %-10s %-16s merged into %s\n' ref "$ref" "$DEFAULT_NAME"
    fi
  done < <(local_refs)
  ((found)) || printf '  nothing to sweep\n'
  ((failed == 0)) || exit 1
  ;;
esac
