#!/usr/bin/env bash
# build-format — auto-format the file the builder just wrote.
# Wired as a Claude PostToolUse hook on Edit|Write|MultiEdit|NotebookEdit.
# Silent auto-fix; never blocks. No-op when the file is gone or the type is unknown.
# PURE formatting only (no lint autofix) so it can't strip an import the agent is
# halfway through adding. Safe with tdd-guard: it only rewrites the just-written
# file, and sealed tests never reach here — tdd-guard's PreToolUse gate blocks edits
# to them before this fires.
set -uo pipefail
f=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // .tool_response.filePath // empty' 2>/dev/null)
[[ -n ${f:-} && -f $f ]] || exit 0
case "$f" in
  *.go)  if command -v goimports >/dev/null 2>&1; then goimports -w "$f"
         elif command -v gofmt >/dev/null 2>&1; then gofmt -w "$f"; fi ;;
  *.py)  command -v ruff     >/dev/null 2>&1 && ruff format -q "$f" ;;
  *.rs)  command -v rustfmt  >/dev/null 2>&1 && rustfmt --edition 2021 "$f" ;;
  *.ts|*.tsx|*.js|*.jsx|*.json|*.css|*.scss|*.md|*.yaml|*.yml)
         command -v prettier >/dev/null 2>&1 && prettier --write --log-level warn "$f" ;;
esac
exit 0
