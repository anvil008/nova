<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title>{{DOCUMENT_TITLE}}</title>
  <style>{{INLINE_CSS}}</style>
  <script>
  document.documentElement.dataset.theme =
    window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  </script>
</head>
<body>

<div class="bar">
  <span class="bar-name"><span class="bar-mark">FZ</span>Foundry Zero</span>
  <span class="chip">Code Review</span>
  <span class="bar-spacer"></span>
  <span class="bar-note">{{SUBJECT}}</span>
  <button type="button" id="hints-toggle">&#9671; hints</button>
  <button type="button" id="theme-toggle" aria-label="Toggle colour theme">&#9788;</button>
</div>

<div class="shell">

  <aside class="rail">
    <div class="rail-title">Contents</div>
    <nav>
      <a href="#summary"><span class="num">01</span><span>Summary</span></a>
      <a href="#findings"><span class="num">02</span><span>Findings</span></a>
      <a href="#files"><span class="num">03</span><span>Touched Files</span></a>
      <a href="#dropped"><span class="num">04</span><span>Refuted Candidates</span></a>
      <a href="#method"><span class="num">05</span><span>Method</span></a>
    </nav>
    <div class="rail-foot">
      <div>repo · {{REPO}}</div>
      <div>subject · {{SUBJECT}}</div>
      <div>lenses · {{LENS_COUNT}}</div>
    </div>
  </aside>

  <main>

    <section class="section" id="header">
      <div class="doc-eyebrow">Review &middot; generated <time datetime="{{GENERATED_AT}}">{{DISPLAY_DATE}}</time></div>
      <h1>{{TITLE}}</h1>
      <p class="lede">{{LEDE}}</p>

      <div class="verdict-row">
        <div class="verdict {{VERDICT_CLASS}}">
          <span class="verdict-dot pulse"></span>
          <div>
            <div class="verdict-label">Verdict</div>
            <div class="verdict-value">{{VERDICT_TEXT}}</div>
          </div>
        </div>
        <div class="verdict" style="flex: 0 0 auto;">
          <div>
            <div class="verdict-label">Weakest confidence</div>
            <div class="confidence" style="margin-top: 4px;">
              {{CONFIDENCE_METER}}
              <span class="v">{{CONFIDENCE_LABEL}}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="meta-grid">
        <div><dt>Repository</dt><dd>{{REPO}}</dd></div>
        <div><dt>Subject</dt><dd>{{SUBJECT}}</dd></div>
        <div><dt>Base</dt><dd>{{BASE}}</dd></div>
        <div><dt>Lenses</dt><dd>{{LENS_COUNT}}</dd></div>
        <div><dt>Findings</dt><dd>{{VERIFIED_COUNT}}</dd></div>
        <div><dt>Generated</dt><dd>{{GENERATED_AT}}</dd></div>
      </div>
    </section>

    <section class="section" id="summary">
      <div class="section-head"><span class="num">01</span><h2>Summary</h2></div>
      <div class="spec"><span class="mark">&#9671;</span>
        <div><b>metrics-row</b> &mdash; the funnel from raw lens output to verified findings. A large drop between candidates and verified means the adversarial pass is doing its job.</div>
      </div>
      {{METRICS}}
      {{TOPOLOGY}}
      <h3>Lenses applied</h3>
      <div class="tags">{{LENSES}}</div>
      <p class="muted" style="margin-top:16px;">Lens count is chosen from the change, never a fixed N. Every finding below survived an independent refutation attempt by a reviewer that did not originate it.</p>
    </section>

    <section class="section" id="findings">
      <div class="section-head"><span class="num">02</span><h2>Findings</h2><span class="count">{{VERIFIED_COUNT}} verified</span></div>
      <div class="spec"><span class="mark">&#9671;</span>
        <div><b>findings-list</b> &mdash; data: findings[]{file, line, severity: critical|high|medium|low|nit, lens, claim, failureScenario, confidence, verification{refutationAttempt, evidence}}. Ordered by severity, then file, line, claim, lens.</div>
      </div>
      <div class="filters" data-filter-group="severity">
        <span class="filter-label">Severity</span>{{SEVERITY_FILTERS}}
      </div>
      <div class="filters" data-filter-group="lens">
        <span class="filter-label">Lens</span>{{LENS_FILTERS}}
      </div>
      <div class="rows" id="finding-rows">{{FINDINGS}}</div>
      <div class="empty" id="no-matches" hidden>No findings match the active filters.</div>
      {{IMPACT_MAP}}
    </section>

    <section class="section" id="files">
      <div class="section-head"><span class="num">03</span><h2>Touched Files</h2><span class="count">{{FILE_COUNT}}</span></div>
      <div class="spec"><span class="mark">&#9671;</span>
        <div><b>file-index</b> &mdash; every file carrying a verified finding, with one severity mark per finding. Files with no finding are not listed; this is a finding index, not a diff stat.</div>
      </div>
      {{FILES}}
    </section>

    <section class="section" id="dropped">
      <div class="section-head"><span class="num">04</span><h2>Refuted Candidates</h2><span class="count">{{DROPPED_COUNT}}</span></div>
      <div class="spec"><span class="mark">&#9671;</span>
        <div><b>dropped</b> &mdash; candidates a lens raised that the independent verifier could not substantiate. These are shown, not hidden: the refuting evidence is what makes the surviving findings credible.</div>
      </div>
      {{DROPPED}}
    </section>

    <section class="section" id="method">
      <div class="section-head"><span class="num">05</span><h2>Method</h2></div>
      <div class="steps">
        <article class="step-card"><div class="n">Step 1</div><h3>Lens fan-out</h3>
          <p>One read-only reviewer per applicable lens, in parallel. Correctness and tests always apply; the rest are selected from the change&rsquo;s actual risks.</p></article>
        <article class="step-card"><div class="n">Step 2</div><h3>Deterministic merge</h3>
          <p>Deduplicated by (file, line, claim). Ties break by severity, confidence, then lens and failure scenario &mdash; so collection order cannot change this report.</p></article>
        <article class="step-card"><div class="n">Step 3</div><h3>Adversarial verification</h3>
          <p>A reviewer that did not raise the claim tries to refute it against the code. Anything it cannot substantiate is dropped to section 04.</p></article>
        <article class="step-card"><div class="n">Step 4</div><h3>Verdict</h3>
          <p>Any critical or high finding blocks. Remaining findings approve with nits. No findings approves.</p></article>
      </div>
      <div class="callout note"><span class="mark">&#9679;</span>
        <p>Reviewer and verifier output is evidence, not authority. The primary agent running the review owns the consolidated verdict.</p>
      </div>
    </section>

  </main>
</div>

<script>
(() => {
  const root = document.documentElement;

  document.getElementById("theme-toggle").addEventListener("click", () => {
    const next = root.dataset.theme === "light" ? "dark" : "light";
    root.dataset.theme = next;
    document.getElementById("theme-toggle").innerHTML = next === "light" ? "&#9789;" : "&#9788;";
  });

  document.getElementById("hints-toggle").addEventListener("click", () => {
    root.dataset.hints = root.dataset.hints === "off" ? "on" : "off";
  });

  // Two independent filter groups; a row must satisfy both to stay visible.
  const groups = [...document.querySelectorAll("[data-filter-group]")].map((node) => ({
    key: node.dataset.filterGroup,
    buttons: [...node.querySelectorAll(".filter")],
  }));
  const rows = [...document.querySelectorAll("#finding-rows .row")];
  const empty = document.getElementById("no-matches");

  function apply() {
    let shown = 0;
    for (const row of rows) {
      const visible = groups.every((group) => {
        const active = group.buttons.filter((b) => b.getAttribute("aria-pressed") === "true");
        return active.some((b) => b.dataset.value === row.dataset[group.key]);
      });
      row.hidden = !visible;
      if (visible) { shown += 1; }
    }
    empty.hidden = shown !== 0 || rows.length === 0;
  }

  for (const group of groups) {
    for (const button of group.buttons) {
      button.addEventListener("click", () => {
        const on = button.getAttribute("aria-pressed") === "true";
        button.setAttribute("aria-pressed", on ? "false" : "true");
        apply();
      });
    }
  }

  let reopened = [];
  window.addEventListener("beforeprint", () => {
    reopened = [...document.querySelectorAll("details:not([open])")];
    reopened.forEach((node) => { node.open = true; });
  });
  window.addEventListener("afterprint", () => {
    reopened.forEach((node) => { node.open = false; });
    reopened = [];
  });
})();
</script>
</body>
</html>
