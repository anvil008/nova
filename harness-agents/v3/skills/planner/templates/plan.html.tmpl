<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{DOCUMENT_TITLE}}</title>
  <style>{{INLINE_CSS}}</style>
</head>
<body>
  <main class="folio">
    <header class="folio-head">
      <div class="brand"><strong>Foundry Zero</strong><span>Implementation Plan · {{PLAN_ID}}</span></div>
      <p class="eyebrow">Planning folio</p>
      <h1>{{PLAN_NAME}}</h1>
      <p class="subtitle">{{SUMMARY}}</p>
      <div class="meta">
        <time datetime="{{GENERATED_AT}}">{{DISPLAY_DATE}}</time>
        <span class="pill">Proposed · Awaiting approval</span>
        <a class="milestone-link" href="{{MILESTONE_URL}}">Milestone: {{PLAN_NAME}}</a>
      </div>
    </header>

    <section class="section" id="overview">
      <span class="section-number">01</span>
      <h2>Overview / Goal</h2>
      <p class="lede">{{SUMMARY}}</p>
      <p class="muted">Repository: {{REPO}} · Stable plan identity: {{PLAN_ID}}</p>
    </section>

    <section class="section" id="architecture">
      <span class="section-number">02</span>
      <h2>Architecture</h2>
      <div class="component-grid">{{COMPONENTS}}</div>
      <h3>Target architecture</h3>
      {{ARCHITECTURE_DIAGRAM}}
    </section>

    <section class="section" id="tasks">
      <span class="section-number">03</span>
      <h2>Task Breakdown</h2>
      <div class="issue-grid">{{ISSUE_CARDS}}</div>
      <h3>Dependency DAG</h3>
      {{DEPENDENCY_DIAGRAM}}
      <h3>Dependency table</h3>
      <div class="table-shell">{{ISSUE_TABLE}}</div>
    </section>

    <section class="section" id="risks">
      <span class="section-number">04</span>
      <h2>Risks &amp; Open Questions</h2>
      <div class="risk-grid">{{RISKS}}</div>
    </section>

    <section class="section" id="execution">
      <span class="section-number">05</span>
      <h2>Milestone &amp; Execution</h2>
      <p class="execution-note">After review, explicit human approval is required before the milestone or any issues are written to GitHub. Reconciliation uses stable plan and issue markers, updates changed work, and closes removed work.</p>
      <h3>Execution waves</h3>
      {{WAVES_DIAGRAM}}
    </section>

    <footer class="footer">Foundry Zero · {{PLAN_NAME}} · Generated {{DISPLAY_DATE}}</footer>
  </main>
  <script>{{MERMAID_JS}}</script>
  <script>
  (() => {
    const explicit = document.documentElement.getAttribute("data-theme");
    const dark = explicit ? explicit === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
    const themeName = dark ? "dark" : "default";
    const themeVariables = dark
      ? {background:"#16171a",primaryColor:"#1d1f24",primaryTextColor:"#e8e8e6",lineColor:"#9a9a9a",secondaryColor:"#2a2d33",tertiaryColor:"#1d1f24"}
      : {background:"#f7f6f3",primaryColor:"#ffffff",primaryTextColor:"#1a1a1a",lineColor:"#6b6b6b",secondaryColor:"#e2e0da",tertiaryColor:"#ffffff"};
    const themeCSS = ".neutral rect,.neutral polygon,.neutral path{fill:transparent!important;stroke:var(--mut)!important}.neutral .nodeLabel,.neutral span{color:var(--mut)!important}";
    mermaid.initialize({startOnLoad:false,securityLevel:"strict",theme:themeName,themeVariables,themeCSS});
    const render = async () => {
      for (const node of document.querySelectorAll("pre.mermaid")) {
        const shell = node.closest(".diagram-shell");
        try {
          await mermaid.run({nodes:[node],suppressErrors:false});
        } catch (error) {
          shell?.classList.add("diagram-failed");
          const message = shell?.querySelector(".diagram-error");
          if (message) message.textContent = "Diagram could not render; source is preserved below.";
        }
      }
    };
    render();
  })();
  </script>
</body>
</html>
