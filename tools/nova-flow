TOKEN_FIELDS = ('input_tokens', 'output_tokens', 'cache_read_tokens', 'cache_write_tokens', 'reasoning_tokens')
MAX_BYTES = 16 * 1024 * 1024
MAX_ITEMS = 4096
MAX_EVENTS = 32768
SCHEMA = 1
TASK_STATES = ('pending', 'working', 'blocked', 'done', 'failed', 'canceled')
AGENT_STATES = ('idle', 'working', 'waiting', 'done', 'failed')
TERMINAL = {'done', 'failed', 'canceled'}


def now():
    return datetime.now(timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z')


def identifier(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,79}', value):
        raise ValueError('IDs must be 1–80 letters, digits, underscores, or hyphens')
    return value


def require(condition, message):
    if not condition:
        raise ValueError(message)


def find(items, key):
    return next((item for item in items if item['id'] == key), None)


def acyclic(items, links):
    by_id = {x['id']: x for x in items}; done = set(); active = set()
    for key in by_id:
        stack = [(key, False)]
        while stack:
            node, leaving = stack.pop()
            require(node in by_id, f'Unknown dependency or parent: {node}')
            if leaving:
                active.remove(node); done.add(node); continue
            if node in done: continue
            require(node not in active, f'Cycle at {node}')
            active.add(node);stack.append((node,True))
            stack.extend((other,False) for other in reversed(links(by_id[node])))


def timestamp(value):
    require(isinstance(value, str), 'Timestamp must be a string')
    parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
    require(parsed.tzinfo is not None, 'Timestamps must include a timezone')
    return parsed


def validate_usage(usage, usage_ids):
    identifier(usage['id'])
    require(usage['id'] not in usage_ids, 'Duplicate usage record ID across attempts')
    usage_ids.add(usage['id'])
    timestamp(usage['updated_at'])
    for key in ('source', 'agent', 'harness', 'model', 'effort'):
        require(isinstance(usage[key], str), f'Usage {key} must be a string')
    require(usage['source'].strip(), 'Usage needs a source reference')
    require(any(key in usage for key in TOKEN_FIELDS), 'Usage needs token counts')
    for key in TOKEN_FIELDS:
        if key in usage:
            require(type(usage[key]) is int and usage[key] >= 0, f'{key} must be a nonnegative integer')


def validate(data):
    require(isinstance(data, dict) and data.get('nova_dagr') == SCHEMA, 'Unsupported Nova Flow schema')
    require(len(data.get('events',[])) <= MAX_EVENTS, 'Too many events; archive this run before continuing')
    require(sum(len(data.get(k,[])) for k in ('tasks','agents','milestones')) + sum(len(t.get('attempts',[])) for t in data.get('tasks',[])) <= MAX_ITEMS, 'Run exceeds graph item limit')
    run = data['run']; identifier(run['id'])
    timestamp(run['created_at']); timestamp(data['updated_at'])
    require(isinstance(run['phase'], str) and run['phase'].strip(), 'Run phase is required')
    require(isinstance(data['revision'], int) and not isinstance(data['revision'], bool), 'Revision must be an integer')
    require(run['state'] in {'active', 'done', 'failed', 'canceled'}, 'Invalid run state')
    require(isinstance(run['title'], str) and run['title'].strip(), 'Run title is required')
    for collection in ('milestones', 'tasks', 'agents', 'events'):
        require(isinstance(data[collection], list), f'{collection} must be an array')
    for collection in ('milestones', 'tasks', 'agents'):
        ids = [identifier(x['id']) for x in data[collection]]
        require(len(ids) == len(set(ids)), f'Duplicate {collection} ID')
    for milestone in data['milestones']:
        require(isinstance(milestone['title'], str) and milestone['title'].strip(), 'Milestone title is required')
    usage_ids = set()
    for task in data['tasks']:
        require(task['state'] in TASK_STATES, 'Invalid task state')
        require(isinstance(task.get('kind','task'),str) and task.get('kind','task').strip(), 'Task kind must be nonempty')
        if task.get('kind')=='gate': require(task['deps'], 'A gate needs at least one input')
        if task.get('issue'):
            require(isinstance(task['issue'], str) and re.fullmatch(r'https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*',task['issue']), 'Issue must be a full GitHub issue URL')
        require(isinstance(task['phase'], str) and task['phase'].strip(), 'Task phase is required')
        require(isinstance(task['note'], str), 'Task note must be a string')
        require(isinstance(task['title'], str) and task['title'].strip(), 'Task title is required')
        require(task['milestone'] is None or find(data['milestones'], task['milestone']), f'Unknown milestone: {task["milestone"]}')
        require(isinstance(task['deps'], list), 'Task dependencies must be an array')
        require(len(task['deps']) == len(set(task['deps'])), 'Duplicate dependency')
        attempts = task['attempts']
        require(isinstance(attempts, list), 'Attempts must be an array')
        for n, attempt in enumerate(attempts, 1):
            require(attempt['number'] == n, 'Attempt numbers must be consecutive')
            require(attempt['state'] in TASK_STATES and attempt['state'] != 'pending', 'Invalid attempt state')
            timestamp(attempt['started_at'])
            if 'progress' in attempt:
                progress = attempt['progress']
                require(isinstance(progress,dict), 'Progress must be an object')
                require(type(progress['done']) is int and type(progress['total']) is int and 0 <= progress['done'] <= progress['total'] and progress['total'] > 0, 'Progress must satisfy 0 <= done <= total, total > 0')
                require(isinstance(progress.get('note',''),str), 'Progress note must be text')
            for usage in attempt.get('usage', []):
                validate_usage(usage, usage_ids)

            if n < len(attempts):
                require(attempt['state'] in TERMINAL, 'Earlier attempts must be settled')
            if attempt['state'] in TERMINAL:
                require(timestamp(attempt.get('ended_at')) >= timestamp(attempt['started_at']), 'Invalid attempt end time')
            if attempt['state'] == 'done':
                require(attempt.get('evidence') and attempt.get('evidence_level') in ('reported', 'verified'), 'Done attempts need evidence')
        if task['state'] not in ('pending', 'canceled'):
            require(attempts and attempts[-1]['state'] == task['state'], 'Task state must match latest attempt')
        if task['state'] == 'canceled' and attempts:
            require(attempts[-1]['state'] == 'canceled', 'Canceled task must settle its last attempt')
        if task['state'] == 'pending':
            require(not attempts, 'Pending task cannot have attempts')
    attempts_by_id = {t['id']+'.a'+str(a['number']): a for t in data['tasks'] for a in t['attempts']}
    for ident, attempt in attempts_by_id.items():
        if 'inputs' in attempt:
            require(isinstance(attempt['inputs'],list) and len(attempt['inputs'])==len(set(attempt['inputs'])), 'Attempt inputs must be distinct references')
            for ref in attempt['inputs']:
                require(ref in attempts_by_id, 'Unknown attempt input')
                source = attempts_by_id[ref]
                require(source['state']=='done' and timestamp(source['ended_at'])<=timestamp(attempt['started_at']), 'Attempt input must have completed before work started')
        cause = attempt.get('cause')
        if cause:
            require(isinstance(cause,dict) and cause.get('ref') in attempts_by_id, 'Retry cause must reference an existing attempt')
            previous = attempts_by_id[cause['ref']]
            require(cause['ref'] != ident and previous['state'] in TERMINAL and timestamp(previous['ended_at']) <= timestamp(attempt['started_at']), 'Retry cause must reference an earlier settled attempt')
    acyclic([{'id':k,'refs':a.get('inputs',[])+([a['cause']['ref']] if a.get('cause') else [])} for k,a in attempts_by_id.items()],lambda a:a['refs'])
    acyclic(data['tasks'], lambda x: x['deps'])
    acyclic(data['tasks'], lambda x: [x['parent_id']] if x.get('parent_id') else [])
    for agent in data['agents']:
        for usage in agent.get('usage', []):
            validate_usage(usage, usage_ids)
        if 'session_id' in agent:
            require(isinstance(agent['session_id'], str) and agent['session_id'], 'Session ID required')
        require(agent['state'] in AGENT_STATES, 'Invalid agent state')
        timestamp(agent['updated_at'])
        for key in ('role', 'harness', 'model', 'effort', 'phase', 'activity'):
            require(isinstance(agent[key], str), f'Agent {key} must be a string')
        if agent.get('task'):
            require(find(data['tasks'], agent['task']), f'Unknown assigned task: {agent["task"]}')
    acyclic(data['agents'], lambda x: [x['parent']] if x.get('parent') else [])
    for e in data['events']:
        timestamp(e['at'])
        require(isinstance(e['type'], str) and isinstance(e['detail'], str), 'Invalid event')
    require([e['seq'] for e in data['events']] == list(range(1, len(data['events']) + 1)), 'Event sequence is invalid')
    require(data['revision'] == len(data['events']), 'Revision must match the event sequence')
    if run['state'] == 'done':
        require(all(t['state'] in ('done', 'canceled') for t in work_tasks(data)), 'Completed run has unfinished tasks')
    if run['state'] != 'active':
        timestamp(run['ended_at'])
        require(not any(t['state'] == 'working' for t in work_tasks(data)), 'Terminal run has working tasks')
        require(not any(a['state'] in ('working', 'waiting') for a in data['agents']), 'Terminal run has active agents')
    return data


def work_tasks(data):
    return [t for t in data['tasks'] if t.get('kind') != 'group']


def group_summary(data, group):
    descendants=set(); pending=[group['id']]
    children={}
    for task in data['tasks']:children.setdefault(task.get('parent_id'),[]).append(task)
    while pending:
        for task in children.get(pending.pop(),[]):
            if task['id'] not in descendants:
                descendants.add(task['id']);pending.append(task['id'])
    tasks=[t for t in work_tasks(data) if t['id'] in descendants]
    counts={state:sum(t['state']==state for t in tasks) for state in TASK_STATES}
    if not tasks:return 'pending','No tasks'
    state=next((v for v in ('working','blocked','failed','pending') if counts[v]),'done' if counts['done'] else 'canceled')
    label=', '.join(str(counts[v])+' '+v for v in ('working','blocked','failed','pending') if counts[v])
    if not label:label=f"{counts['done']}/{len(tasks)} done"+(f", {counts['canceled']} canceled" if counts['canceled'] else '')
    return state,label


def read(path):
    require(not path.is_symlink() and not path.parent.is_symlink(), f'Refusing run symlink: {path}')
    try:
        require(path.stat().st_size <= MAX_BYTES, 'Run file exceeds 16 MiB limit')
        with path.open('rb') as stream: raw = stream.read(MAX_BYTES + 1)
        require(len(raw) <= MAX_BYTES, 'Run file exceeds 16 MiB limit')
        return validate(json.loads(raw))
    except (KeyError, TypeError, RecursionError) as error:
        raise ValueError(f'Malformed run: {error}') from error


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def assign_references(path, data):
    # A separate repository lock avoids lock-order inversion with run writers.
    root=path.parent
    if root.parent.name=='runs':root=root.parent.parent
    elif root.parent.name=='archive':
        root=root.parent.parent
        if root.parent.name=='runs':root=root.parent.parent
    with locked(root/'references'):
        registry=root/'references/index.json'
        saved=json.loads(registry.read_text()) if registry.exists() else {'next':{'G':1,'T':1},'ids':{}}
        def allocate(key,kind,existing=None):
            if key not in saved['ids']:
                if existing:
                    require(existing not in saved['ids'].values(),'Duplicate stable reference')
                    saved['ids'][key]=existing
                    saved['next'][kind]=max(saved['next'][kind],int(existing[1:])+1)
                else:
                    saved['ids'][key]=kind+str(saved['next'][kind]).zfill(2)
                    saved['next'][kind]+=1
            require(not existing or saved['ids'][key]==existing,'Stable reference registry mismatch')
            return saved['ids'][key]
        run=data['run']['id']
        data['run']['display_ref']=allocate(json.dumps([run]),'G',data['run'].get('display_ref'))
        for task in data['tasks']:
            task['display_ref']=allocate(json.dumps([run,task['id']]),'G' if task.get('kind')=='group' else 'T',task.get('display_ref'))
        fd,name=tempfile.mkstemp(prefix='.index-',dir=registry.parent)
        try:
            with os.fdopen(fd,'w') as stream:
                json.dump(saved,stream);stream.flush();os.fsync(stream.fileno())
            os.replace(name,registry);sync_directory(registry.parent)
        finally:Path(name).unlink(missing_ok=True)


def atomic(path, data):
    validate(data)
    assign_references(path,data)
    encoded = json.dumps(data, indent=2, ensure_ascii=False) + '\n'
    require(len(encoded.encode('utf-8')) <= MAX_BYTES, 'Run exceeds 16 MiB limit')
    require(not path.is_symlink(), f'Refusing run symlink: {path}')
    fd, name = tempfile.mkstemp(prefix='.run-', suffix='.tmp', dir=path.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            handle.write(encoded); handle.flush(); os.fsync(handle.fileno())
        os.replace(name, path)
        sync_directory(path.parent)
    finally:
        Path(name).unlink(missing_ok=True)


@contextmanager
def locked(directory):
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / '.lock'
    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def event(data, kind, detail, **refs):
    data['revision'] += 1
    data['updated_at'] = now()
    data['events'].append({'seq': data['revision'], 'at': data['updated_at'],
                           'type': kind, 'detail': detail, **refs})


def create(title, run_id=None):
    stamp = now()
    data = {'nova_dagr': SCHEMA, 'revision': 0,
            'run': {'id': identifier(run_id or 'run-' + uuid.uuid4().hex[:12]),
                    'title': title, 'state': 'active', 'phase': 'spec', 'created_at': stamp},
            'updated_at': stamp, 'milestones': [], 'tasks': [], 'agents': [], 'events': []}
    event(data, 'run_created', title)
    return data


def change(data, args):
    require(data['run']['state'] == 'active', 'Run is finished; archive it and start a new run')
    if args.command == 'phase':
        data['run']['phase'] = args.name
        event(data, 'phase_changed', args.name)
    elif args.command == 'milestone':
        identifier(args.id)
        require(not find(data['milestones'], args.id), 'Milestone ID already exists')
        data['milestones'].append({'id': args.id, 'title': args.title})
        event(data, 'milestone_added', args.title, milestone=args.id)
    elif args.command == 'task':
        if args.action == 'add':
            identifier(args.id)
            require(not find(data['tasks'], args.id), 'Task ID already exists')
            require(args.milestone is None or find(data['milestones'], args.milestone), 'Milestone does not exist')
            data['tasks'].append({'id': args.id, 'title': args.title, 'milestone': args.milestone,
                                  'phase': args.phase or data['run']['phase'], 'deps': args.after,
                                  'state': 'pending', 'note': '', 'attempts': [], 'issue': args.issue, 'kind': args.kind, 'parent_id':args.parent})
            event(data, 'task_added', args.title, task=args.id)
        elif args.action == 'rename':
            task=find(data['tasks'],args.id);require(task,'Task not found')
            task['title']=args.title;task.pop('provisional',None)
            event(data,'task_renamed',args.title,task=args.id)
        elif args.action == 'parent':
            task=find(data['tasks'],args.id);require(task,'Task not found')
            task['parent_id']=None if args.parent=='-' else args.parent
            event(data,'task_parent',args.parent,task=args.id)
        elif args.action == 'progress':
            task = find(data['tasks'],args.id)
            require(task and task['state'] in ('working','blocked') and task['attempts'], 'Progress needs an active attempt')
            task['attempts'][-1]['progress'] = {'done':args.done,'total':args.total,'note':args.note or ''}
            task['note'] = args.note or task['note']
            event(data,'task_progress',f'{args.done}/{args.total} '+(args.note or ''),task=args.id)
        elif args.action in ('edit', 'note'):
            task = find(data['tasks'], args.id)
            require(task, 'Task does not exist')
            if args.action == 'note':
                require(task['state'] not in TERMINAL, 'Settled task notes are retained; create follow-up work')
                task['note'] = args.text
            else:
                require(task['state'] == 'pending', 'Only pending tasks can be replanned')
                for key in ('title', 'milestone', 'phase', 'issue'):
                    if getattr(args, key) is not None:
                        task[key] = getattr(args, key)
                if args.after is not None:
                    task['deps'] = args.after
                elif args.clear_deps:
                    task['deps'] = []
            event(data, 'task_' + args.action, task['note'] if args.action == 'note' else task['title'], task=args.id)
        else:
            task = find(data['tasks'], args.id)
            require(task, 'Task does not exist')
            if args.action == 'retry':
                require(task['state'] in ('failed', 'done', 'canceled'), 'Retry requires a settled task')
                require(args.note, 'Retry requires a reason')
                # Reopening a prerequisite would invalidate already-started downstream work.
                require(not any(args.id in t['deps'] and t['state'] not in ('pending', 'canceled') and not (args.cause and t.get('kind')=='review' and args.cause.rsplit('.a',1)[0]==t['id']) for t in data['tasks']),
                        'Settle/replan downstream work before reopening this dependency')
                state = 'working'
                fresh = True
            else:
                state = args.state
                allowed = {'pending': {'working', 'canceled'}, 'working': {'blocked', 'done', 'failed', 'canceled'},
                           'blocked': {'working', 'failed', 'canceled'}, 'done': set(), 'failed': set(), 'canceled': set()}
                require(state in allowed[task['state']], f'Invalid transition {task["state"]} → {state}; use retry for settled tasks')
                fresh = task['state'] == 'pending' and state == 'working'
            if state in ('working', 'done'):
                require(all(find(data['tasks'], d)['state'] == 'done' for d in task['deps']), 'Dependencies are not done')
            if state in ('blocked', 'failed', 'canceled'):
                require(args.note, 'This state requires a note')
            if state == 'done':
                require(args.evidence, 'Done requires --evidence (a check result or artifact reference)')
            if fresh:
                task['attempts'].append({'number': len(task['attempts']) + 1, 'state': 'working',
                                         'started_at': now(), 'reason': args.note or 'Initial attempt',
                                         'inputs': [d+'.a'+str(find(data['tasks'],d)['attempts'][-1]['number']) for d in task['deps']]})
                if args.action=='retry' and args.cause:
                    task['attempts'][-1]['cause'] = {'ref':args.cause}
            task['state'] = state
            task['note'] = args.note or ''
            if task['attempts']:
                attempt = task['attempts'][-1]
                attempt['state'] = state
                if state in TERMINAL:
                    attempt.update(ended_at=now(), outcome_note=args.note or '', evidence=args.evidence or '',
                                   evidence_level='verified' if args.verified else 'reported',
                                   source_revision=args.source_revision or '')
            if args.agent:
                agent = find(data['agents'], args.agent)
                require(agent, 'Register the agent before assigning a task')
                require(not agent.get('task') or agent['task'] == task['id'], 'Agent is assigned to another task')
                if task['attempts']:
                    task['attempts'][-1].setdefault('workers', {})[agent['id']] = {k: agent[k] for k in ('harness', 'model', 'effort')}
                agent.update(task=task['id'], state='working' if state == 'working' else 'waiting', updated_at=now())
            if state in ('working', 'blocked'):
                for agent in data['agents']:
                    if agent.get('task') == task['id']:
                        agent.update(state='working' if state == 'working' else 'waiting', updated_at=now())
            if state in TERMINAL:
                for agent in data['agents']:
                    if agent.get('task') == task['id']:
                        agent.update(task=None, state='idle', updated_at=now())
            event(data, 'task_' + ('retried' if args.action == 'retry' else state), args.note or task['title'], task=args.id)
    elif args.command == 'usage':
        task = find(data['tasks'], args.task)
        require(task and task['attempts'], 'Start a task attempt before reporting usage')
        attempt = task['attempts'][-1]
        identifier(args.record)
        for other in data['tasks']:
            for past in other['attempts']:
                if past is not attempt:
                    require(not any(u['id'] == args.record for u in past.get('usage', [])), 'Usage record already belongs to another attempt')
        counts = {key: getattr(args, key) for key in TOKEN_FIELDS if getattr(args, key) is not None}
        require(counts, 'Supply at least one token count')
        agent = find(data['agents'], args.agent) if args.agent else None
        require(not args.agent or agent, 'Unknown usage agent')
        record = {'id': args.record, 'source': args.source, 'updated_at': now(), 'agent': args.agent or '',
                  **{key: getattr(args, key) or (agent[key] if agent else '') for key in ('harness', 'model', 'effort')}, **counts}
        records = attempt.setdefault('usage', [])
        existing = find(records, args.record)
        if existing:
            # Repeated provider reports replace this record, never add its counters twice.
            record = {**existing, **counts, 'updated_at': now(), 'source': args.source,
                      **{key: value for key, value in record.items() if key in ('agent', 'harness', 'model', 'effort') and value}}
            records[records.index(existing)] = record
        else:
            records.append(record)
        event(data, 'usage_reported', args.record + ' / ' + (record['model'] or 'model not reported'), task=args.task)
    elif args.command == 'session':
        agent = next((a for a in data['agents'] if a.get('session_id') == args.session), None)
        if args.action == 'attach':
            require(not agent, 'Session is already attached to this run')
            old = next((a for a in args.archived_data['agents'] if a.get('session_id') == args.session), None)
            require(old, 'Session not present in the named archive')
            agent = {k: copy.deepcopy(v) for k, v in old.items() if k not in ('usage', 'binding', 'task', 'activity')}
            agent.update(task=None, state='idle', activity='Explicitly attached from archive', updated_at=now())
            if not find(data['agents'], agent.get('parent')): agent['parent'] = None
            data['agents'].append(agent)
            event(data, 'session_attached', args.archive, agent=agent['id'])
            return
        require(agent, 'Session not registered; run the lifecycle adapter first')
        if args.action=='context':
            require(args.parent=='-' or find(data['tasks'],args.parent),'Parent task not found')
            agent['parent_task']=None if args.parent=='-' else args.parent
            event(data,'session_context',args.parent,agent=agent['id']);return
        require(args.task is not None, 'Binding requires --task')
        if args.task == '-':
            agent.pop('binding', None); agent['task'] = None
        else:
            task = find(data['tasks'], args.task)
            require(task and task['state'] in ('working', 'blocked') and task['attempts'], 'Bind a started task attempt')
            agent['binding'] = {'task': args.task, 'attempt': task['attempts'][-1]['number'], 'at': now()}
            agent['task'] = args.task
            task['attempts'][-1].setdefault('workers', {})[agent['id']] = {k: agent[k] for k in ('harness', 'model', 'effort')}
        agent['updated_at'] = now()
        event(data, 'session_bound', args.task, agent=agent['id'])
    elif args.command == 'agent':
        identifier(args.id)
        agent = find(data['agents'], args.id)
        if not agent:
            agent = {'id': args.id, 'parent': None, 'role': 'main', 'harness': '', 'model': '',
                     'effort': '', 'phase': data['run']['phase'], 'state': 'idle', 'task': None, 'activity': ''}
            data['agents'].append(agent)
        for key in ('parent', 'role', 'harness', 'model', 'effort', 'phase', 'state', 'task', 'activity'):
            value = getattr(args, key)
            if value is not None:
                agent[key] = None if key in ('parent', 'task') and value == '-' else value
        agent['updated_at'] = now()
        if agent.get('task'):
            task = find(data['tasks'], agent['task'])
            if task and task['attempts'] and task['state'] not in TERMINAL:
                task['attempts'][-1].setdefault('workers', {})[agent['id']] = {k: agent[k] for k in ('harness', 'model', 'effort')}
        event(data, 'agent_updated', agent['activity'] or agent['state'], agent=args.id)
    elif args.command == 'finish':
        require(args.note, 'Finish requires a summary note')
        require(not any(t['state'] == 'working' for t in work_tasks(data)), 'Settle working tasks first')
        data['run'].update(state=args.state, ended_at=now(), summary=args.note)
        event(data, 'run_finished', args.note)
    validate(data)


def archive(directory):
    path = directory / 'run.json'
    data = read(path)
    require(data['run']['state'] in TERMINAL, 'Only finished runs can be archived')
    destination = directory / 'archive' / data['run']['id']
    require(not (directory / 'archive').is_symlink() and not destination.is_symlink(), 'Refusing archive directory symlink')
    destination.mkdir(parents=True, exist_ok=True)
    target = destination / 'run.json'
    require(not target.is_symlink(), 'Refusing archive symlink')
    # Same-filesystem hard link atomically preserves the complete validated snapshot.
    # If interruption occurs before unlink, an identical existing snapshot permits retry.
    try:
        os.link(path, target, follow_symlinks=False)
    except FileExistsError:
        require(target.read_bytes() == path.read_bytes(), 'Archive ID collision; existing archive preserved')
    sync_directory(destination)
    sync_directory(destination.parent)
    sync_directory(directory)
    path.unlink()
    sync_directory(directory)
    return target


def project_store(cwd):
    """Resolve shared repository identity, never merge unrelated clones by remote URL."""
    import subprocess
    cwd = Path(cwd).resolve()
    for parent in (cwd,*cwd.parents):
        repo = parent/'.jj/repo'
        if repo.exists():
            shared = (repo.parent / repo.read_text().strip()).resolve() if repo.is_file() else repo.resolve()
            return shared.parent.parent/'.nova'
        if (parent/'.git').exists():
            result = subprocess.run(['git','-C',str(parent),'rev-parse','--path-format=absolute','--git-common-dir'],capture_output=True,text=True)
            if result.returncode: return parent/'.nova'
            shared = Path(result.stdout.strip()).resolve()
            return (shared.parent if shared.name=='.git' else shared)/'.nova'
    return cwd/'.nova'


def run_paths(directory):
    return ([directory/'run.json'] if (directory/'run.json').exists() else []) + sorted((directory/'runs').glob('*/run.json'))


def migrate_legacy(directory):
    """Relocate legacy records unchanged; never replace an existing run."""
    moved=[]
    with locked(directory):
        sources=([directory/'run.json'] if (directory/'run.json').exists() else [])
        sources+=sorted((directory/'archive').glob('*/run.json'))
        transfers=[]
        for source in sources:
            data=read(source); ident=identifier(data['run']['id'])
            destination=directory/'runs'/ident
            if source.parent!=directory:destination=destination/'archive'/ident
            target=destination/'run.json'
            require(not target.exists(), f'Migration destination already exists: {target}')
            require(target not in [t for _,t in transfers], 'Duplicate migration destination')
            transfers.append((source,target))
        for source,target in transfers:
            target.parent.mkdir(parents=True,exist_ok=True)
            with locked(target.parent):
                # Exclusive link preserves exact bytes and refuses concurrent creation.
                os.link(source,target)
                sync_directory(target.parent)
                source.unlink()
                sync_directory(source.parent)
            moved.append(str(target))
    return moved


def session_store(directory, harness, session, join=None, create_run=False, workspace=None):
    """Call with the project lock held. Session identities are harness-qualified."""
    for path in run_paths(directory):
        data=read(path)
        if data['run'].get('owner')==harness+':'+session or any(a.get('session_id')==session and a['harness']==harness for a in data['agents']):
            require(not join or join==data['run']['id'], 'Session already belongs to another run')
            return path.parent
    if join:
        identifier(join)
        matches=[p.parent for p in run_paths(directory) if read(p)['run']['id']==join]
        require(len(matches)==1,'Shared run not found or ambiguous')
        return matches[0]
    if not create_run: return None
    import hashlib
    ident=harness+'-'+hashlib.sha256(session.encode()).hexdigest()[:20]
    destination=directory/'runs'/ident
    require(not (destination/'archive'/ident/'run.json').exists(), 'Session run is archived; start a new session')
    destination.mkdir(parents=True,exist_ok=True)
    data=create((Path(workspace).name if workspace else 'Project')+' · '+harness,ident)
    data['run'].update(owner=harness+':'+session,lifecycle='active')
    atomic(destination/'run.json',data)
    return destination


def lifecycle(directory,harness,session,action,join=None,workspace=None):
    """Portable session adapter; only confirmed exits close a participant."""
    import hashlib
    identifier(harness)
    with locked(directory):
        destination=session_store(directory,harness,session,join,action=='start',workspace)
        require(destination is not None,'Session is not registered')
        with locked(destination) if destination!=directory else nullcontext():
            data=read(destination/'run.json')
            ident=harness+'-'+hashlib.sha256(session.encode()).hexdigest()[:20]
            agent=find(data['agents'],ident)
            if not agent:
                agent=dict(id=ident,session_id=session,parent=None,role='main',harness=harness,model='',effort='',phase=data['run']['phase'],state='idle',task=None,activity='',updated_at=now())
                data['agents'].append(agent)
            agent.update(session_closed=action=='end',workspace=str(Path(workspace or '.').resolve()),updated_at=now())
            if action=='end': agent.update(state='idle',activity='Session exited')
            else: agent.update(state='working',activity='Session connected')
            if action=='end':
                for child in data['agents']:
                    if child.get('launcher_session')==session:child.update(session_closed=True,state='idle')
            sessions=[a for a in data['agents'] if a.get('session_id')]
            closed=bool(sessions) and all(a.get('session_closed',False) for a in sessions)
            settled=all(t['state'] in TERMINAL for t in work_tasks(data))
            data['run']['lifecycle']='interrupted' if closed and not settled else 'active'
            event(data,'session_'+action,harness+' session '+action,agent=ident)
            if closed and settled and not any(a['state'] in ('working','waiting') for a in data['agents']):
                data['run'].update(state='failed' if any(t['state']=='failed' for t in work_tasks(data)) else 'done',ended_at=now(),summary='All participating sessions closed; tasks settled',lifecycle='archived')
                atomic(destination/'run.json',data)
                return archive(destination)
            atomic(destination/'run.json',data)
            return destination


def selected_run(directory,key=None):
    if key:
        identifier(key)
        candidates=[p for p in run_paths(directory) if read(p)['run']['id']==key]
        candidates += list((directory/'archive'/key).glob('run.json'))
        candidates += list((directory/'runs').glob('*/archive/'+key+'/run.json'))
        require(len(candidates)==1,'Run not found or ambiguous')
        return read(candidates[0])
    paths=run_paths(directory)
    if not paths: raise FileNotFoundError('No active runs')
    if len(paths)==1:return read(paths[0])
    # Read-only projection. Source facts and IDs remain in each run store.
    combined=create('Repository · '+str(len(paths))+' runs','repository')
    for n,path in enumerate(paths):
        data=copy.deepcopy(read(path));prefix='r'+str(n+1)+'--'
        for m in data['milestones']:m['id']=prefix+m['id']
        for t in data['tasks']:
            t['id']=prefix+t['id'];t['deps']=[prefix+d for d in t['deps']]
            if t.get('parent_id'):t['parent_id']=prefix+t['parent_id']
            if t['milestone']:t['milestone']=prefix+t['milestone']
            for a in t['attempts']:
                if a.get('cause'):a['cause']['ref']=prefix+a['cause']['ref']
                if 'inputs' in a:a['inputs']=[prefix+i for i in a['inputs']]
                a['workers']={prefix+k:v for k,v in a.get('workers',{}).items()}
                for u in a.get('usage',[]):
                    if u.get('agent'):u['agent']=prefix+u['agent']
        roots=[t for t in data['tasks'] if not t.get('parent_id')]
        if roots and not (len(roots)==1 and roots[0].get('kind')=='group'):
            group_id=prefix+'run-group'
            for t in roots:t['parent_id']=group_id
            data['tasks'].insert(0,dict(id=group_id,title=data['run']['title'],kind='group',state='pending',attempts=[],deps=[],milestone=None,phase=data['run']['phase'],note='',display_ref=data['run'].get('display_ref',data['run']['id'])))
        for a in data['agents']:
            a['id']=prefix+a['id']
            if a.get('parent'):a['parent']=prefix+a['parent']
            if a.get('task'):a['task']=prefix+a['task']
        for field in ('tasks','milestones','agents'):combined[field].extend(data[field])
        combined['updated_at']=max(combined['updated_at'],data['updated_at'])
    return combined


def summaries(directory):
    results = []
    paths = run_paths(directory)
    paths += sorted((directory / 'archive').glob('*/run.json')) + sorted((directory/'runs').glob('*/archive/*/run.json'))
    for path in paths:
        data = read(path)
        results.append({**data['run'], 'archived': 'archive' in path.relative_to(directory).parts, 'updated_at': data['updated_at']})
    return results


def terminal(data):
    def clean(text):
        return ''.join(c if c.isprintable() else ' ' for c in str(text))
    lines = [f'{data["run"]["title"]}  [{data["run"]["state"]}]  phase: {data["run"]["phase"]}',
             f'Run {data["run"]["id"]} · revision {data["revision"]} · updated {data["updated_at"]}']
    for milestone in data['milestones'] + ([{'id': None, 'title': 'Ungrouped'}] if any(t['milestone'] is None for t in data['tasks']) else []):
        tasks = [t for t in data['tasks'] if t['milestone'] == milestone['id']]
        done = sum(t['state'] == 'done' for t in tasks if t.get('kind')!='group')
        if milestone['id'] is not None: lines.append(f'\n{milestone["id"]} · {milestone["title"]} ({done}/{sum(t.get('kind')!='group' for t in tasks)} done)')
        for task in tasks:
            if task.get('kind')=='group':
                lines.append('  group     '+display_reference(task)+' · '+task['title']+' · '+group_summary(data,task)[1]);continue
            agents = ', '.join(a['id'] for a in data['agents'] if a.get('task') == task.get('_task_id',task['id']) and not task.get('_historical'))
            deps = ' ← ' + ', '.join(task['deps']) if task['deps'] else ''
            lines.append(f'  {task["state"]:9} {display_reference(task)} · {task_tags(task)}{task["title"]} [{task["phase"]}]{deps}' + (f' · {agents}' if agents else ''))
            if task['note']:
                lines.append('            ' + task['note'])
    lines.append('\nAgents (reported activity)')
    for agent in data['agents']:
        parent = f' ↳ {agent["parent"]}' if agent['parent'] else ''
        lines.append(f'  {agent["id"]}{parent} · {agent["role"]} · {agent["state"]} · {agent["phase"]} · {agent["harness"]} {agent["model"]}')
        if agent['activity']:
            lines.append('    ' + agent['activity'])
        lines.extend('    Session-only '+k.replace('_', ' ')+': '+str(sum(u.get(k,0) for u in agent.get('usage',[]))) for k in TOKEN_FIELDS if any(k in u for u in agent.get('usage',[])))
    for task in data['tasks']:
        lines.append('\n' + task['id'] + ' / models & tokens')
        lines.extend(usage_lines(task))
    return '\n'.join(clean(line) for line in lines)


def usage_lines(task, compact=False):
    if compact:
        records = [u for a in task['attempts'] for u in a.get('usage', [])]
        if not records: return ['Tokens: not reported for this attempt']
        def total(key):
            values = [r[key] for r in records if key in r]
            return (f'{sum(values):,}' + (' (partial)' if len(values)<len(records) else '')) if values else '—'
        return ['Tokens: '+total('input_tokens')+' in / '+total('output_tokens')+' out',
                'Cache read '+total('cache_read_tokens')+' · write '+total('cache_write_tokens')+' · reasoning '+total('reasoning_tokens')]

    lines = []
    records = [u for a in task['attempts'] for u in a.get('usage', [])]
    if records:
        lines.append('Reported task totals (all attempts)')
        for key in TOKEN_FIELDS:
            values = [r[key] for r in records if key in r]
            value = f'{sum(values):,}' if values else 'not reported'
            if values and len(values) < len(records): value += ' (partial)'
            lines.append('  ' + key.replace('_', ' ') + ': ' + value)
        lines.append('Cache/reasoning breakdowns are not added to input/output.')
    for attempt in task['attempts']:
        for agent, runtime in attempt.get('workers', {}).items():
            lines.append(f'Attempt {attempt["number"]} · {agent} · ' + ' / '.join(runtime.get(k) or 'not reported' for k in ('harness', 'model', 'effort')))
        for record in attempt.get('usage', []):
            lines.append(f'Attempt {attempt["number"]} · {record["agent"] or "unassigned"} · {record["model"] or "model not reported"}')
            lines.append(' / '.join(record.get(k) or 'not reported' for k in ('harness', 'effort')))
            for key in TOKEN_FIELDS:
                value = f'{record[key]:,}' if key in record else 'not reported'
                lines.append('  ' + key.replace('_', ' ') + ': ' + value)
            lines.append('  Source: ' + record['source'])
    if not any(a.get('usage') for a in task['attempts']):
        lines.append('Token usage: not reported')
    return lines


def task_rows(data):
    """Topological task order and a separate track for each dependency edge."""
    pending = list(data['tasks']); tasks = []; seen = set()
    while pending:
        ready = next((t for t in pending if all(d in seen for d in ([t['parent_id']] if t.get('parent_id') else []))), None)
        if ready is None:
            raise ValueError('Task dependency cycle')
        pending.remove(ready); tasks.append(ready); seen.add(ready['id'])
    positions = {t['id']: i for i, t in enumerate(tasks)}
    # One displayed parent keeps the graph compact. All other DAG edges are
    # explicit in the dependency annotation rather than invented tree links.
    parents = {t['id']:t.get('parent_id') for t in tasks}
    rows = []
    for t in tasks:
        ancestors = []; parent = parents[t['id']]
        while parent:
            ancestors.insert(0, parent); parent = parents[parent]
        prefix = ''
        for ancestor in ancestors[:-1]:
            remaining = any(parents[o['id']] == ancestor and positions[o['id']] > positions[t['id']] for o in tasks)
            prefix += '│ ' if remaining else '  '
        if ancestors:
            siblings = any(parents[o['id']] == parents[t['id']] and positions[o['id']] > positions[t['id']] for o in tasks)
            prefix += '├─' if siblings else '└─'
        rows.append((prefix, t))
    return rows


def display_reference(task):
    reference=task.get('display_ref',task.get('_task_id',task['id']))
    if task.get('_historical') or (task.get('_task_id') and task['attempts'] and task['attempts'][0]['number']>1):
        reference+='.a'+str(task['attempts'][0]['number'])
    return reference


def task_tags(task):
    labels = []
    if task.get('milestone'): labels.append(task['milestone'])
    if task.get('issue'): labels.append('#'+task['issue'].rsplit('/',1)[-1])
    return ('['+' · '.join(labels)+'] ') if labels else ''


def task_runtime(data, task, model_only=False):
    if task.get('kind')=='group':return ''
    attempt = task['attempts'][-1] if task['attempts'] else {}
    runtimes = list(attempt.get('workers', {}).values()) + attempt.get('usage', [])
    runtimes += [a for a in data['agents'] if a.get('task') == task.get('_task_id',task['id']) and not task.get('_historical')]
    if model_only: return ', '.join(dict.fromkeys(r['model'] for r in runtimes if r.get('model'))) or '—'
    labels = list(dict.fromkeys('·'.join(filter(None, (r.get('model'), r.get('effort') or 'effort —'))) for r in runtimes if r.get('model')))
    return ', '.join(labels) or 'model/effort —'


def task_tokens(task):
    records = [u for a in task['attempts'] for u in a.get('usage', [])]
    def field(key):
        values = [u[key] for u in records if key in u]
        if not values: return '—'
        count = sum(values)
        text = f'{count/1000000:.1f}m' if count >= 1000000 else f'{count/1000:.1f}k' if count >= 1000 else str(count)
        return text + ('*' if len(values) < len(records) else '')
    return field('input_tokens') + '/' + field('output_tokens')


def age_text(start, end=None):
    if not start:
        return 'unknown'
    seconds = max(0, int((timestamp(end) if end else datetime.now(timezone.utc)).timestamp() - timestamp(start).timestamp()))
    return f'{seconds//86400}d {seconds%86400//3600}h' if seconds>=86400 else f'{seconds//3600}h {seconds%3600//60}m' if seconds>=3600 else f'{seconds//60}m {seconds%60}s'


def view_rows(data, query='', folded=False):
    """Derived presentation only: stable attempt identities, no new run facts."""
    result = []
    for prefix, original in task_rows(data):
        if original.get('kind')=='group':
            state,label=group_summary(data,original)
            original={**original,'state':state,'_group_label':label}
        if folded and original['state'] in ('done','canceled'):
            continue
        search = ' '.join([original['id'], original['title'], original['milestone'] or '', original.get('issue') or '',
                          *[a['id'] for a in data['agents'] if a.get('task')==original['id']],
                          *[who for a in original['attempts'] for who in a.get('workers', {})],
                          *[r.get('model','') for a in original['attempts'] for r in a.get('workers', {}).values()],
                          *[u.get('model','') for a in original['attempts'] for u in a.get('usage', [])]])
        if query.casefold() not in search.casefold(): continue
        blockers = [d for d in original['deps'] if find(data['tasks'],d)['state']!='done']
        attempts = original['attempts'] or [None]
        for attempt in attempts:
            task = {**original, '_task_id': original['id'], '_blockers': blockers,
                    '_progress_age': age_text(next((e['at'] for e in reversed(data['events']) if e.get('task')==original['id'] and e['type'].startswith('task_')),None)),
                    '_join': original.get('kind')=='gate' or ('kind' not in original and len(original['deps'])>1), '_historical': bool(attempt and attempt is not original['attempts'][-1])}
            if attempt:
                task.update(id=original['id']+'.a'+str(attempt['number']), attempts=[attempt], state=attempt['state'])
                task['_cause'] = attempt.get('cause',{}).get('ref')
                task['_inputs'] = attempt.get('inputs', [d+'.a'+str(matches[-1]['number']) for d in original['deps'] if (matches := [a for a in find(data['tasks'],d)['attempts'] if a.get('ended_at') and a['state']=='done' and timestamp(a['ended_at'])<=timestamp(attempt['started_at'])])])
                task['_blockers'] = []
                task['_progress'] = attempt.get('progress')
                task['_elapsed'] = age_text(attempt['started_at'],attempt.get('ended_at'))
                ending = original['attempts'][attempt['number']]['started_at'] if task['_historical'] else None
                outcome = next((e['detail'] for e in reversed(data['events']) if e.get('task')==original['id'] and e['type']=='task_'+attempt['state'] and timestamp(e['at'])>=timestamp(attempt['started_at']) and (not ending or timestamp(e['at'])<timestamp(ending))), '')
                task['_row_note'] = (attempt.get('outcome_note') or outcome or attempt.get('reason','')) if task['_historical'] else original['note']
            else:
                task['_elapsed'] = task.get('_group_label','not started');task['_row_note'] = original['note']
            # Fan-in is a join boundary, never a child of an arbitrary prerequisite.
            result.append(('⋈ ' if task['_join'] else prefix+('↩ ' if attempt and attempt['number']>1 else ''), task))
    latest = {t['id']: t['id']+'.a'+str(t['attempts'][-1]['number']) if t['attempts'] else t['id'] for t in data['tasks']}
    for _, task in result:
        if not task['attempts']: task['_inputs'] = [latest[d] for d in task['deps']]
        prior = task['_task_id']+'.a'+str(task['attempts'][0]['number']-1) if task['attempts'] and task['attempts'][0]['number']>1 else None
        task['_parent_ref'] = latest.get(task.get('parent_id'))
        task['_edges'] = list(dict.fromkeys(task['_inputs']+([task.get('_cause') or prior] if task.get('_cause') or prior else [])))
    pending = result[:]; ordered = []; visible = {t['id'] for _,t in result}; seen = set()
    while pending:
        row = next((r for r in pending if all(d not in visible or d in seen for d in r[1]['_edges'])),None)
        require(row is not None, 'Attempt dependency cycle')
        pending.remove(row); ordered.append(row); seen.add(row[1]['id'])
    return ordered


def diagnostics(directory, data=None, error=None, archived=False):
    lines = ['Store: '+str(directory), 'Selection: '+('archive' if archived else 'current run'),
             'Data: '+(str(error) if error else 'valid' if data else 'no run.json'),
             'Hook installation: not inspected; observed events are the evidence below.']
    if not data: return lines+['Start work with nova-flow init TITLE, or browse an archive.']
    lines += ['Run: '+data['run']['id']+' / '+data['run']['state'], 'Last stored update: '+age_text(data['updated_at'])+' ago',
              'Freshness measures reports, not process health.']
    sessions = [a for a in data['agents'] if a.get('session_id')]
    lines.append('Registered runtime sessions: '+str(len(sessions)))
    if not sessions: lines.append('No session telemetry observed. Check plugin activation, project cwd, and hook logs.')
    for a in sessions:
        binding=a.get('binding');telemetry=a.get('telemetry',{})
        lines += ['',a['id']+' / '+a['session_id'], 'Model: '+(a['model'] or 'not reported')+' / effort: '+(a['effort'] or 'not reported'),
                  'Binding: '+(binding['task']+'.a'+str(binding['attempt']) if binding else 'none; usage stays session-only'),
                  'Last observation: '+age_text(a['updated_at'])+' ago', 'Transcript cursor: '+str(telemetry.get('offset','not observed')),
                  'Telemetry: '+telemetry.get('warning','no warning reported')]
    for t in work_tasks(data):
        if not any(a.get('usage') for a in t['attempts']):
            lines.append(t['id']+': no task usage; needs attributed provider data after a session binding/turn boundary.')
    return lines


