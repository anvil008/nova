    return data


def layout(data):
    agents={a['id']:a for a in data['agents']}
    lanes=[('main','MAIN')]
    for a in data['agents']:
        if a.get('parent'):lanes.append((a['id'],('BUILDER' if a.get('role')=='implementer' else (a.get('role') or 'helper').upper())))
    lane_index={ident:i for i,(ident,_) in enumerate(lanes)}
    rows=[]
    for _,task in view_rows(data):
        if task.get('kind')=='group':continue
        workers=list((task['attempts'][-1] if task['attempts'] else {}).get('workers',{}))
        workers+=[a['id'] for a in data['agents'] if a.get('task')==task['_task_id']]
        owner=workers[0] if workers else None
        # An unassigned task has no asserted executor; its marker is hollow.
        lane=lane_index.get(owner,0)
        rows.append({'task':task,'lane':lane,'owner':owner,'delegated':bool(owner in agents and agents[owner].get('parent'))})
    return lanes,rows


def sections(data, rows):
    groups={}
    for row in rows:
        task=row['task'];parent=task.get('parent_id');root=None
        while parent:
            ancestor=find(data['tasks'],parent)
            if not ancestor:break
            if ancestor.get('kind')=='group':root=ancestor
            parent=ancestor.get('parent_id')
        key=root['id'] if root else data['run']['id']
        if key not in groups:groups[key]={'title':root['title'] if root else data['run']['title'],'rows':[]}
        groups[key]['rows'].append(row)
    return list(groups.values())


def tree_rows(data, rows):
    """Nest only recorded task parents; keep dependency edges as annotations."""
    by_task={}
    for row in rows:by_task.setdefault(row['task']['_task_id'],[]).append(row)
    children={}
    for ident,attempts in by_task.items():
        parent=attempts[0]['task'].get('parent_id')
        children.setdefault(parent if parent in by_task else None,[]).append(ident)
    output=[]
    def walk(ident,prefix,last):
        attempts=by_task[ident];latest=attempts[-1]
        original=find(data['tasks'],ident)
        multiple=len(original['attempts'])>1
        task={**latest['task'],**original,'_historical':False} if multiple else latest['task']
        output.append({**latest,'task':task,'tree':prefix+('└─' if last else '├─'),
                       'label':original['title'],'ref':original.get('display_ref') or ident,'attempt_row':False})
        nested=prefix+('  ' if last else '│ ')
        descendants=children.get(ident,[])
        if multiple:
            for i,row in enumerate(attempts):
                t=row['task'];end=i==len(attempts)-1 and not descendants
                note=t.get('_row_note') or t['attempts'][-1].get('reason') or 'Attempt '+str(t['attempts'][-1]['number'])
                output.append({**row,'tree':nested+('└─' if end else '├─'),
                               'label':note.removeprefix('Demo: '),'ref':'a'+str(t['attempts'][-1]['number']),'attempt_row':True})
        for i,child in enumerate(descendants):walk(child,nested,i==len(descendants)-1)
    for i,ident in enumerate(children.get(None,[])):walk(ident,'',i==len(children[None])-1)
    return output


def requirements(data,row):
    if row.get('attempt_row'):return ''
    return ', '.join((find(data['tasks'],d).get('display_ref') or d) for d in row['task']['deps'])


def dependency_badges(data,row):
    if row.get('attempt_row'):return []
    marks={'done':'✓','working':'◐','failed':'×','blocked':'!','pending':'○','canceled':'−'}
    result=[]
    for ident in row['task']['deps']:
        task=find(data['tasks'],ident)
        result.append(((task.get('display_ref') or ident)+marks[task['state']],task['state']))
    return result


TOKEN_KEYS=('input_tokens','output_tokens','cache_read_tokens','cache_write_tokens')

def aggregate_usage(data):
    """Sum source records once across session-only and historical task storage."""
    groups={};seen=set()
    records=[u for a in data['agents'] for u in a.get('usage',[])]
    records += [u for t in data['tasks'] for a in t['attempts'] for u in a.get('usage',[])]
    for u in records:
        identity=(u.get('harness',''),u['id'])
        if identity in seen:continue
        seen.add(identity)
        key=(u.get('harness',''),u.get('model') or 'unknown model')
        groups.setdefault(key,[]).append(u)
    for a in data['agents']:
        if a.get('model'):groups.setdefault((a.get('harness',''),a['model']),[])
    return groups


def usage_header(data,prices=None):
    groups=aggregate_usage(data);all_records=[u for records in groups.values() for u in records]
    def number(value):
        return f'{value/1e6:.2f}m' if value>=1e6 else f'{value/1e3:.1f}k' if value>=1000 else str(value)
    def total(records,key):
        values=[u[key] for u in records if key in u]
        return (number(sum(values))+('*' if len(values)<len(records) else '')) if values else '—'
    def pair(records,a,b):return total(records,a)+'/'+total(records,b)
    def cost(key,records,bucket=None):
        rate=(prices or {}).get('/'.join(key))
        if not records or not isinstance(rate,dict):return None
        if type(rate.get('input_includes_cache')) is not bool:return None
        if any(type(rate.get(k)) not in (int,float) or not math.isfinite(rate[k]) or rate[k]<0 for k in TOKEN_KEYS):return None
        value=0
        for u in records:
            if any(k not in u for k in TOKEN_KEYS):return None
            uncached=u['input_tokens']-(u['cache_read_tokens']+u['cache_write_tokens'] if rate['input_includes_cache'] else 0)
            if uncached<0:return None
            amounts={**u,'input_tokens':uncached}
            value+=sum(amounts[k]*rate[k] for k in ([bucket] if bucket else TOKEN_KEYS))/1e6
        return value
    costs=[cost(key,records) for key,records in groups.items() if records]
    complete=costs and all(c is not None for c in costs)
    combined=number(sum(u['input_tokens']+u['output_tokens'] for u in all_records)) if all_records and all('input_tokens' in u and 'output_tokens' in u for u in all_records) else '—'
    def money(value):return '—' if value is None else f'${value:.2f}' if value>=.01 or value==0 else f'${value:.4f}'
    active=[(key,records) for key,records in groups.items() if records]
    title=active[0][0][1] if len(active)==1 else 'ALL MODELS'
    lines=[f'{title} · {combined} tokens',f'{"USAGE":<19}{"TOKENS":>10}{"COST":>11}']
    uncached=[]
    for key,records in active:
        for u in records:
            inclusive=(prices or {}).get('/'.join(key),{}).get('input_includes_cache',True if key[0]=='codex' else None)
            if inclusive is None or any(k not in u for k in TOKEN_KEYS):continue
            value=u['input_tokens']-(u['cache_read_tokens']+u['cache_write_tokens'] if inclusive else 0)
            if value>=0:uncached.append(value)
    for label,bucket in [('Input (uncached)','input_tokens'),('Cache read','cache_read_tokens'),('Cache write','cache_write_tokens'),('Output','output_tokens')]:
        count=(number(sum(uncached))+('*' if len(uncached)<len(all_records) else '')) if bucket=='input_tokens' and uncached else '—' if bucket=='input_tokens' else total(all_records,bucket)
        values=[cost(key,records,bucket) for key,records in active]
        value=sum(values) if values and all(v is not None for v in values) else None
        lines.append(f'{label:<19}{count:>10}{money(value):>11}')
    lines.append(f'{"TOTAL":<19}{combined:>10}{money(sum(costs) if complete else None):>11}')
    if len(active)>1:
        for key,records in sorted(active):lines.append(key[1]+' '+money(cost(key,records)))
    if not all_records:lines.append('No usage reported')
    return lines


