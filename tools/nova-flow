def serve(directory, host, port, managed=False):
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            route = urlparse(self.path)
            try:
                if route.path == '/':
                    page=Path(__file__).with_name('nova-flow.html')
                    body, content_type = page.read_bytes(), 'text/html; charset=utf-8'
                elif route.path == '/api/demo':
                    data=read(Path(__file__).with_name('nova-flow-demo.json'))
                    data['_view']={'rows':view_rows(data),'diagnostics':[]}
                    body,content_type=json.dumps(data).encode(),'application/json'
                elif route.path == '/api/health':
                    body,content_type=json.dumps({'store':str(directory.resolve()),'pid':os.getpid()}).encode(),'application/json'
                elif route.path == '/api/runs':
                    body, content_type = json.dumps(summaries(directory)).encode(), 'application/json'
                elif route.path == '/api/run':
                    key = parse_qs(route.query).get('id', ['active'])[0]
                    path = directory / 'run.json' if key == 'active' else directory / 'archive' / identifier(key) / 'run.json'
                    data = selected_run(directory,None if key=='active' else key)
                    data['_view'] = {'rows': view_rows(data), 'diagnostics': diagnostics(directory,data,archived=key!='active')}
                    body, content_type = json.dumps(data).encode(), 'application/json'
                else:
                    self.send_error(404); return
                self.send_response(200)
                self.send_header('Content-Type', content_type)
                self.send_header('Cache-Control', 'no-store')
                self.send_header('X-Content-Type-Options', 'nosniff')
                self.send_header('Content-Security-Policy', "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'")
                self.end_headers(); self.wfile.write(body)
            except FileNotFoundError:
                self.send_error(404, 'No run found')
            except (ValueError, KeyError, TypeError) as error:
                self.send_error(400, 'Invalid run data')
        def log_message(self, *args):
            pass
    try:server = ThreadingHTTPServer((host, port), Handler)
    except OSError:
        if not managed:raise
        server=ThreadingHTTPServer((host,0),Handler)
    if managed:
        import socket
        with socket.socket(socket.AF_INET,socket.SOCK_DGRAM) as probe:
            try:probe.connect(('10.255.255.255',1));address=probe.getsockname()[0]
            except OSError:address='127.0.0.1'
        info={'pid':os.getpid(),'port':server.server_port,'url':f'http://{address}:{server.server_port}/'}
        path=directory/'viewer.json';temp=directory/'.viewer.json.tmp'
        temp.write_text(json.dumps(info));os.replace(temp,path)
    print(f'Nova Flow: http://{host}:{server.server_port} (read-only)', flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()


def report_activity(data, agent, kind, payload):
    """Persist observable activity; semantic progress and completion remain explicit."""
    if kind not in ('PostToolUse','PreInvocation','PostInvocation'):return
    if 'nova-flow' in json.dumps(payload.get('tool_input',{})):return
    binding=agent.get('binding',{})
    task=find(data['tasks'],binding.get('task'))
    if not task or task['state'] not in ('working','blocked'):
        parent=find(data['agents'],agent.get('parent'))
        scope=agent.get('parent_task') or (parent.get('task') or parent.get('parent_task') if parent else None)
        if not scope or not find(data['tasks'],scope):
            scope='scope'
            if not find(data['tasks'],scope):
                change(data,parser().parse_args(['task','add',scope,data['run']['title'],'--kind','group']))
            agent['parent_task']=scope
        number=1
        while find(data['tasks'],f'work-{number}'):number+=1
        ident=f'work-{number}'
        change(data,parser().parse_args(['task','add',ident,'Unclassified work','--parent',scope]))
        change(data,parser().parse_args(['task','set',ident,'working','--agent',agent['id']]))
        change(data,parser().parse_args(['session','bind',agent['session_id'],'--task',ident]))
        task=find(data['tasks'],ident);task['provisional']=True
        agent['tracking_notice']='Name the provisional task '+ident+' and keep its outcome current.'
    if not task.get('provisional'):agent.pop('tracking_notice',None)
    tool=payload.get('tool_name') or (payload.get('toolCall') or {}).get('name')
    label='Tool: '+tool if isinstance(tool,str) else kind
    old=task.get('last_activity')
    if not old or old['label']!=label or (timestamp(now())-timestamp(old['at'])).total_seconds()>=5:
        task['last_activity']={'label':label,'at':now()}
        event(data,'task_activity',label,task=task['id'])


def parser():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--dir', type=Path, default=None, help='Run store (default: .nova under cwd)')
    p.add_argument('--run',default=os.environ.get('NOVA_RUN_ID'),help='Select a run for mutations')
    sub = p.add_subparsers(dest='command', required=True)
    sub.add_parser('references',help='Assign stable display references to existing runs and archives')
    sub.add_parser('migrate',help='Move legacy root and archive records under runs/ without changing their contents')
    q=sub.add_parser('track',help='Launch a harness with session lifecycle tracking');q.add_argument('--harness',required=True);q.add_argument('--session',default=None);q.add_argument('program',nargs=argparse.REMAINDER)
    q=sub.add_parser('lifecycle',help='Portable session start/end adapter');q.add_argument('action',choices=['start','end']);q.add_argument('--harness',required=True);q.add_argument('--session',required=True)
    q = sub.add_parser('init'); q.add_argument('title'); q.add_argument('--id')
    q = sub.add_parser('phase'); q.add_argument('name', help='spec, plan, build, review, or another workflow phase')
    q = sub.add_parser('milestone'); q.add_argument('id'); q.add_argument('title')
    q = sub.add_parser('task'); commands = q.add_subparsers(dest='action', required=True)
    q = commands.add_parser('add'); q.add_argument('id'); q.add_argument('title'); q.add_argument('--milestone', help='Optional milestone ID'); q.add_argument('--issue', help='Full GitHub issue URL'); q.add_argument('--parent'); q.add_argument('--kind',default='task',help='task, review, gate, question, or a custom kind'); q.add_argument('--phase'); q.add_argument('--after', action='append', default=[])
    q = commands.add_parser('rename');q.add_argument('id');q.add_argument('title')
    q = commands.add_parser('parent'); q.add_argument('id');q.add_argument('parent')
    q = commands.add_parser('edit'); q.add_argument('id')
    for key in ('title', 'milestone', 'phase', 'issue'): q.add_argument('--' + key)
    deps = q.add_mutually_exclusive_group(); deps.add_argument('--after', action='append'); deps.add_argument('--clear-deps', action='store_true')
    q = commands.add_parser('progress'); q.add_argument('id'); q.add_argument('--done',type=int,required=True); q.add_argument('--total',type=int,required=True); q.add_argument('--note')
    q = commands.add_parser('note'); q.add_argument('id'); q.add_argument('text')
    for action in ('set', 'retry'):
        q = commands.add_parser(action); q.add_argument('id')
        if action == 'retry': q.add_argument('--cause',help='Earlier settled attempt ID, such as review.a1')
        if action == 'set': q.add_argument('state', choices=TASK_STATES)
        q.add_argument('--note'); q.add_argument('--evidence'); q.add_argument('--verified', action='store_true'); q.add_argument('--source-revision'); q.add_argument('--agent')
    q = sub.add_parser('usage', help='Report task-attempt token counts from an identified source')
    q.add_argument('task'); q.add_argument('--record', required=True); q.add_argument('--source', required=True)
    for key in TOKEN_FIELDS: q.add_argument('--' + key.replace('_', '-'), type=int)
    for key in ('agent', 'harness', 'model', 'effort'): q.add_argument('--' + key)
    q = sub.add_parser('session'); q.add_argument('action', choices=['bind', 'attach','context']); q.add_argument('session'); q.add_argument('--task', help='Started task ID, or - to unbind'); q.add_argument('--parent'); q.add_argument('--archive', help='Source archive for explicit session attach')
    q = sub.add_parser('agent'); q.add_argument('id')
    for key in ('parent', 'role', 'harness', 'model', 'effort', 'phase', 'task', 'activity'):
        q.add_argument('--' + key)
    q.add_argument('--state', choices=AGENT_STATES)
    q = sub.add_parser('finish'); q.add_argument('--state', choices=sorted(TERMINAL), default='done'); q.add_argument('--note', required=True)
    sub.add_parser('archive'); sub.add_parser('list')
    for command in ('view', 'check', 'doctor'):
        q = sub.add_parser(command); q.add_argument('--archive', help='Archived run ID'); q.add_argument('--json', action='store_true')
        if command == 'view':
            q.add_argument('--demo', action='store_true', help='Show illustrative data without writing run records')
            q.add_argument('--watch', action='store_true')
            q.add_argument('--plain', action='store_true', help='Print text instead of the interactive terminal UI')
    sub.add_parser('web',help='Start or reuse the repository browser viewer and print its URL')
    q = sub.add_parser('serve'); q.add_argument('--managed',action='store_true'); q.add_argument('--host', default='127.0.0.1'); q.add_argument('--port', type=int, default=8910)
    return p


def main(argv=None):
    p = parser(); argv = list(sys.argv[1:] if argv is None else argv)
    commands=next(a.choices for a in p._actions if isinstance(a,argparse._SubParsersAction))
    if not any(value in commands for value in argv):
        view_flags=[x for x in argv if x in ('--demo','--plain')]
        argv=[x for x in argv if x not in view_flags]+['view']+view_flags
    args = p.parse_args(argv); directory = args.dir.expanduser().absolute() if args.dir else project_store(Path.cwd())
    global _WEB_URL
    try:
        if args.command=='web':print(ensure_viewer(directory));return
        if args.command!='serve' and sys.stdout.isatty() and os.environ.get('NOVA_FLOW_NO_WEB')!='1':
            try:
                _WEB_URL=ensure_viewer(directory)
                if args.command!='view':print('Nova Flow web: '+_WEB_URL,file=sys.stderr)
            except (OSError,ValueError) as error:print('Nova viewer: '+str(error),file=sys.stderr)
        if args.command=='references':
            with locked(directory):
                paths=run_paths(directory)+sorted((directory/'archive').glob('*/run.json'))+sorted((directory/'runs').glob('*/archive/*/run.json'))
                for path in paths:
                    with locked(path.parent) if path.parent!=directory else nullcontext():atomic(path,read(path))
            print(json.dumps({'updated':len(paths)}));return
        if args.command=='migrate':
            require(not args.run, 'Migrate operates on the repository store; omit --run')
            print(json.dumps({'moved':migrate_legacy(directory)}));return
        if args.command=='lifecycle':
            print(lifecycle(directory,args.harness,args.session,args.action,args.run,Path.cwd()));return
        if args.command=='track':
            import subprocess
            session=args.session or uuid.uuid4().hex
            program=args.program[1:] if args.program[:1]==['--'] else args.program
            require(program,'Supply the harness command after --')
            destination=lifecycle(directory,args.harness,session,'start',args.run,Path.cwd())
            ident=read(destination/'run.json')['run']['id']
            try:
                result=subprocess.run(program,env={**os.environ,'NOVA_RUN_ID':ident,'NOVA_SESSION_ID':session})
            finally:lifecycle(directory,args.harness,session,'end',workspace=Path.cwd())
            sys.exit(result.returncode)
        if args.run:
            candidates=[p.parent for p in run_paths(directory) if read(p)['run']['id']==args.run]
            require(len(candidates)==1,'Run not found or ambiguous');directory=candidates[0]
        if args.command == 'serve':
            serve(directory, args.host, args.port, args.managed); return
        if args.command == 'list':
            print(json.dumps(summaries(directory), indent=2)); return
        if args.command == 'doctor':
            path = directory / 'archive' / identifier(args.archive) / 'run.json' if args.archive else directory / 'run.json'
            try: info = diagnostics(directory, read(path), archived=bool(args.archive))
            except (OSError, ValueError) as error: info = diagnostics(directory, error=error, archived=bool(args.archive))
            print(json.dumps(info) if args.json else '\n'.join(info)); return
        if args.command in ('view', 'check'):
            if args.command == 'view' and not args.json and not args.watch:
                flow_view(directory,args.archive,args.demo,args.plain or not (sys.stdin.isatty() and sys.stdout.isatty())); return
            path = directory / 'archive' / identifier(args.archive) / 'run.json' if args.archive else directory / 'run.json'
            while True:
                data = demo() if getattr(args,'demo',False) else selected_run(directory,args.archive)
                if args.command == 'check':
                    print(json.dumps({'valid': True, 'revision': data['revision']}) if args.json else 'Valid Nova Flow run'); break
                if args.watch and sys.stdout.isatty(): print('\033[2J\033[H', end='')
                if args.json:print(json.dumps(data, indent=2),flush=True)
                else:flow_view(directory,args.archive,args.demo,True)
                if not args.watch: break
                time.sleep(2)
            return
        if not args.run and not (directory/'run.json').exists() and run_paths(directory):
            require(len(run_paths(directory))==1,'Multiple runs: select --run RUN_ID')
            directory=run_paths(directory)[0].parent
        with locked(directory):
            if args.command == 'archive':
                print(archive(directory)); return
            path = directory / 'run.json'
            if args.command == 'init':
                require(not path.exists(), 'run.json already exists; finish/archive it or choose another --dir')
                data = create(args.title, args.id)
                require(not (directory / 'archive' / data['run']['id']).exists(), 'Run ID already archived; choose a new ID')
            else:
                data = read(path)
                if args.command == 'session' and args.action == 'attach':
                    require(args.archive, 'Session attach requires --archive')
                    args.archived_data = read(directory / 'archive' / identifier(args.archive) / 'run.json')
                if args.command in ('task','session','agent','usage'):
                    def resolve(value):
                        if not value:return value
                        matches=[t['id'] for t in data['tasks'] if t.get('display_ref')==value or t['id']==value]
                        require(len(set(matches))<=1,'Ambiguous task reference')
                        return matches[0] if matches else value
                    fields=['task']
                    if args.command=='task':
                        fields+=['parent']
                        if args.action!='add':fields+=['id']
                    if args.command=='usage':fields+=['task']
                    for field in fields:
                        if hasattr(args,field):setattr(args,field,resolve(getattr(args,field)))
                    if getattr(args,'after',None):args.after=[resolve(x) for x in args.after]
                    if getattr(args,'cause',None):
                        base,number=args.cause.rsplit('.a',1);args.cause=resolve(base)+'.a'+number
                change(data, args)
            atomic(path, data)
            print(json.dumps({'run': data['run']['id'], 'revision': data['revision'], 'path': str(path)}))
    except KeyboardInterrupt:
        pass
    except (OSError, ValueError, KeyError, TypeError) as error:
        p.exit(1, f'nova-flow: {error}\n')




if __name__ == '__main__':
    main()
