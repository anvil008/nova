def inspector(data,row,width):
    t=row['task'];ref=display_reference(t)
    lines=[ref+'  '+t['title'],t['state'].upper()+'  ·  '+(task_runtime(data,t) if row['owner'] else 'Executor not assigned')]
    def reference(ident):
        found=find(data['tasks'],ident)
        return display_reference(found) if found else ident
    if t['deps']:lines.append('Requires: '+', '.join(reference(x) for x in t['deps']))
    if t.get('parent_id'):
        group=find(data['tasks'],t['parent_id']);lines.append('Objective: '+group['title'])
    agent=find(data['agents'],row['owner']) if row['owner'] else None
    if agent:lines.append('Agent: '+agent['id'])
    if agent and agent.get('workspace'):lines.append('Workspace: '+agent['workspace'])
    attempt=t['attempts'][-1] if t['attempts'] else {}
    if attempt.get('reason'):lines.append('Attempt: '+attempt['reason'])
    if attempt.get('progress'):
        progress=attempt['progress'];lines.append(f"Progress: {progress['done']}/{progress['total']} · {progress.get('note','')}")
    if attempt.get('source_revision'):lines.append('Checked revision: '+attempt['source_revision'])
    if attempt.get('evidence'):lines.append('Evidence: '+attempt['evidence'])
    if t.get('_row_note'):lines.append(t['_row_note'])
    return [part for line in lines for part in textwrap.wrap(line,max(10,width))]


def flow_view(directory,run_id=None,is_demo=False,plain=False):
    def read():return demo() if is_demo else selected_run(directory,run_id)
    if plain:
        def emit(text):print(''.join(c if c.isprintable() or c=='\n' else ' ' for c in str(text)))
        data=read();lanes,rows=layout(data)
        emit('NOVA FLOW'+('   DEMO · sample data' if is_demo else '   LIVE'))
        emit(data['run']['title'])
        emit('\n'.join(usage_header(data,read_prices())))
        for group in sections(data,rows):
            emit(group['title']);emit('TASK FLOW                                                     AGENT / MODEL                     STATE')
            for row in tree_rows(data,group['rows']):
                runtime=(lanes[row['lane']][1].lower()+' · '+task_runtime(data,row['task'],model_only=True)) if row['owner'] else '—'
                deps=' ← '+' '.join(label for label,state in dependency_badges(data,row)) if dependency_badges(data,row) else ''
                emit(f"{row['tree']} {row['ref']} {row['label']}{deps}  ·  {runtime}  ·  {row['task']['state']}")
        return
    def screen(win):
        try:curses.curs_set(0)
        except curses.error:pass
        win.timeout(200)
        if curses.has_colors():
            curses.start_color();curses.use_default_colors()
            for i,c in enumerate((curses.COLOR_BLUE,curses.COLOR_GREEN,curses.COLOR_CYAN,curses.COLOR_YELLOW,curses.COLOR_RED,curses.COLOR_MAGENTA),1):curses.init_pair(i,c,-1)
            if curses.COLORS>=256:
                for pair,value in ((1,75),(3,81),(5,209),(6,141)):curses.init_pair(pair,value,-1)
        def color(n):return curses.color_pair(n) if curses.has_colors() else 0
        def put(y,x,s,w,attr=0):
            try:win.addnstr(y,x,''.join(c if c.isprintable() else ' ' for c in str(s)),max(0,w),attr)
            except curses.error:pass
        selection=None;offset=0;details=False;fold=False;refresh=0;data=None;error='';choices=[];choice=run_id
        while True:
            if time.monotonic()>=refresh:
                try:
                    data=demo() if is_demo else selected_run(directory,choice)
                    choices=[] if is_demo else [r['id'] for r in summaries(directory)]
                    error=''
                except (OSError,ValueError) as exc:error=str(exc);data=None
                refresh=time.monotonic()+2
            win.erase();height,width=win.getmaxyx()
            summary=usage_header(data,read_prices()) if data else []
            right_width=min(max((len(line) for line in summary),default=0),max(20,width-36)) if width>=100 else width-4
            right_x=width-right_width-2 if width>=100 else 2
            usage_y=0 if width>=100 else 2
            graph_top=max(3,usage_y+len(summary)+1)
            put(0,2,'NOVA FLOW',max(0,right_x-4) if width>=100 else width-4,color(1)|curses.A_BOLD)
            for i,line in enumerate(summary):put(usage_y+i,right_x,line,right_width,color(1) if i==0 else curses.A_DIM)
            put(height-1,2,'↑↓ scroll   d back to tasks   q quit' if details else '↑↓ task   h hide done   [ ] run   d details   q quit',width-4,curses.A_DIM)
            if data:
                lanes,all_rows=layout(data)
                rows=[r for r in all_rows if not fold or r['task']['state'] not in ('done','canceled')]
                rows=[r for group in sections(data,rows) for r in tree_rows(data,group['rows'])]
                index=next((i for i,r in enumerate(rows) if r['task']['id']==selection),0)
                if rows:selection=rows[index]['task']['id']
                done=sum(t['state']=='done' for t in work_tasks(data))
                put(1,2,('DEMO · ' if is_demo else '')+f"{done}/{len(work_tasks(data))} done",max(0,right_x-4) if width>=100 else width-4,curses.A_DIM)
                content=inspector(data,rows[index],min(100,width-6)) if rows else ['No visible tasks. Press h to show completed work.']
                detail_height=min(len(content)+2,max(4,height//2)) if details else min(5,max(3,height//4))
                detail_top=height-detail_height-2
                entries=[]
                for group in sections(data,rows):
                    if entries:entries.append(('space',None))
                    entries.append(('group',group))
                    entries.append(('columns',None))
                    for r in group['rows']:
                        entries.append(('task',r))

                selected_line=next((i for i,(kind,r) in enumerate(entries) if kind=='task' and r['task']['id']==selection),0)
                available=max(1,detail_top-graph_top-1)
                start=max(0,selected_line-available+2)
                # Keep an objective heading visible when scrolling through its tasks.
                display=entries[start:]
                if start and display and display[0][0]!='group':
                    header=next((entry for entry in reversed(entries[:start]) if entry[0]=='group'),None)
                    if header:display=[header]+([] if display[0][0]=='columns' else [('columns',None)])+display
                status_x=max(30,width-13)
                model_width=32 if width>=115 else 22 if width>=90 else 14 if width>=70 else 0
                model_x=status_x-model_width-2 if model_width else status_x
                for pos,(kind,row) in enumerate(display[:available]):
                    y=graph_top+pos
                    if kind=='space':continue
                    if kind=='columns':
                        put(y,3,'TASK FLOW',max(0,model_x-5),curses.A_DIM)
                        if model_width:put(y,model_x,'AGENT / MODEL',model_width,curses.A_DIM)
                        put(y,status_x,'STATE',11,curses.A_DIM)
                        continue
                    if kind=='group':
                        current=[r for r in row['rows'] if not r.get('attempt_row')]
                        count=sum(r['task']['state']=='done' for r in current)
                        title=row['title']+f"  ·  {count}/{len(current)} done"
                        put(y,2,title,width-4,color(1)|curses.A_BOLD)
                        continue
                    t=row['task'];state=t['state']
                    tint=color(2 if state=='done' else 3 if state=='working' else 4 if state=='blocked' else 5 if state=='failed' else 1)
                    symbol={'done':'●','working':'◉','failed':'×','blocked':'!','canceled':'−','pending':'○'}[state]
                    branch=row['tree']
                    put(y,3,branch,min(len(branch),max(0,model_x-5)),curses.A_DIM)
                    node_x=3+len(branch)
                    if node_x<model_x-2:put(y,node_x,symbol,1,tint)
                    ref=row['ref'];label_x=node_x+2
                    if label_x<model_x-2:put(y,label_x,ref,min(len(ref),model_x-label_x-2),tint|curses.A_BOLD)
                    title_x=label_x+len(ref)+1
                    badges=dependency_badges(data,row)
                    suffix=' ← '+' '.join(label for label,state in badges) if badges else ''
                    room=max(0,model_x-title_x-2)
                    # Keep join references visible when there is still room for a useful title.
                    reserve=len(suffix) if room>=len(suffix)+12 else 0
                    title_room=max(0,room-reserve)
                    title=row['label']
                    if len(title)>title_room:title=title[:max(0,title_room-1)]+('…' if title_room else '')
                    put(y,title_x,title,title_room,curses.A_BOLD if t['id']==selection else curses.A_DIM if state=='canceled' else 0)
                    if suffix and (reserve or len(title)+len(suffix)<=room):
                        x=title_x+len(title)
                        put(y,x,' ← ',3,color(6));x+=3
                        for label,dep_state in badges:
                            put(y,x,label,len(label),color(2 if dep_state=='done' else 3 if dep_state=='working' else 5 if dep_state=='failed' else 4 if dep_state=='blocked' else 1));x+=len(label)+1
                    if model_width:
                        runtime=(lanes[row['lane']][1].lower()+' · '+task_runtime(data,t,model_only=True)) if row['owner'] else '—'
                        put(y,model_x,runtime,model_width,curses.A_DIM)
                    put(y,status_x,state,11,tint)
                    if t['id']==selection:put(y,0,'▸',1,color(1))
                put(detail_top,2,'─'*max(0,min(108,width-4)),width-4,color(1))
                offset=min(offset,max(0,len(content)-detail_height+1))
                for i,line in enumerate(content[offset:offset+detail_height-1]):put(detail_top+1+i,3,line,width-6,curses.A_BOLD if i==0 and offset==0 else 0)
            else:put(4,2,error,width-4,color(4));rows=[];index=0
            win.refresh();key=win.getch()
            if key in (ord('q'),27):break
            if key==ord('d'):details=not details;offset=0
            if details and key in (curses.KEY_UP,curses.KEY_DOWN):offset=max(0,offset+(1 if key==curses.KEY_DOWN else -1))
            if not details and key in (curses.KEY_UP,curses.KEY_DOWN) and rows:
                index=max(0,min(len(rows)-1,index+(1 if key==curses.KEY_DOWN else -1)));selection=rows[index]['task']['id'];offset=0
            if key==ord('h'):fold=not fold;offset=0
            if key in (ord('['),ord(']')) and choices:
                options=[None]+choices;i=options.index(choice) if choice in options else 0
                choice=options[(i+(1 if key==ord(']') else -1))%len(options)];refresh=0;selection=None;offset=0
    curses.wrapper(screen)



def viewer_store(directory):
    directory=Path(directory).resolve()
    if directory.parent.name=='runs':return directory.parent.parent
    return directory


def ensure_viewer(directory):
    import subprocess
    import urllib.request
    root=viewer_store(directory);metadata=root/'viewer.json'
    def running():
        try:
            info=json.loads(metadata.read_text())
            with urllib.request.urlopen('http://127.0.0.1:'+str(info['port'])+'/api/health',timeout=.3) as response:
                live=json.load(response)
            return info['url'] if live.get('store')==str(root) and live.get('pid')==info['pid'] else None
        except (OSError,ValueError,KeyError):return None
    with locked(root/'viewer'):
        url=running()
        if url:return url
        with (root/'viewer/server.log').open('ab') as log:
            process=subprocess.Popen([sys.executable,str(Path(__file__).resolve()),'--dir',str(root),'serve','--host','0.0.0.0','--port','8910','--managed'],stdin=subprocess.DEVNULL,stdout=log,stderr=log,start_new_session=True,cwd=str(root.parent))
        import threading
        threading.Thread(target=process.wait,daemon=True).start()
        for _ in range(40):
            url=running()
            if url:return url
            if process.poll() is not None:break
            time.sleep(.05)
        raise ValueError('Viewer did not start; inspect '+str(root/'viewer/server.log'))


